{
	"extends": "./tsconfig.json",
	"include": [
		"app/**/*.test.ts",
		"app/**/*.test.tsx",
		"app/test/setup.ts",
		"scripts/**/*.test.ts",
		"tests/**/*.test.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"tests/**/*.spec.ts",
		"tests/perf/**",
		"test-results/**",
		"node_modules/**",
		"build/**",
		".react-router/**"
	],
	"compilerOptions": {
		"types": ["node", "vite/client", "vitest/globals"],
		"noEmit": true
	}
}
