{
  "name": "react-app-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "eslint app/**/*.tsx --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "react-router typegen && tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run app",
    "test:component": "vitest run app/components --passWithNoTests",
    "test:integration": "vitest run app/lib app/services --passWithNoTests",
    "test:migration:ui-quality": "node scripts/run-import-ui-quality-tests.mjs",
    "test:obligations": "node scripts/check-test-obligations.mjs",
    "test:e2e": "playwright test tests/*.spec.ts",
    "test:e2e:dm4-fresh-db": "playwright test tests/dm4-fresh-db-migration.e2e.spec.ts",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:e2e:payroll-correction": "playwright test tests/smoke/payroll-correction-modal.spec.ts",
    "test:payroll-correction": "vitest run app/lib/utils/payroll-correction-form.test.ts app/lib/utils/payroll-correction-day-markers.test.ts",
    "test:regression": "vitest run app --passWithNoTests",
    "test:ci": "npm run typecheck:test && npm test",
    "quality:ci": "npm run test:obligations && npm run test:ci && npm run test:e2e:smoke && npm run build",
    "quality:strict": "npm run lint && npm run typecheck && npm run test:routes && npm run test:unreachable && npm run test:e2e",
    "test:routes": "vitest run tests/unused-routes.test.ts",
    "test:attendance-perf": "playwright test tests/perf/hr-attendance.spec.ts",
    "clean-routes": "tsx scripts/clean-unused-routes.ts",
    "test:unreachable": "vitest run tests/unreachable-routes.test.ts",
    "clean-unreachable-routes": "tsx scripts/clean-unreachable-routes.ts",
    "detect:duplicates": "tsx scripts/detect-duplicates.ts",
    "audit:admin-config-ui": "node scripts/audit-admin-config-ui.mjs",
    "audit:admin-config-ui:strict": "node scripts/audit-admin-config-ui.mjs --strict",
    "audit:admin-config-patterns": "tsx scripts/admin-config-pattern-intelligence.ts",
    "audit:admin-config-patterns:strict": "tsx scripts/admin-config-pattern-intelligence.ts --strict",
    "refactor:admin-config-patterns:dry-run": "tsx scripts/admin-config-pattern-intelligence.ts --scope hierarchy",
    "refactor:admin-config-patterns": "tsx scripts/admin-config-pattern-intelligence.ts --scope hierarchy --apply",
    "refactor:routes:dry-run": "tsx scripts/refactor-routes.ts --dry-run",
    "refactor:routes": "tsx scripts/refactor-routes.ts",
    "update:routes-config:dry-run": "tsx scripts/update-routes-config.ts --dry-run",
    "update:routes-config": "tsx scripts/update-routes-config.ts",
    "delete:employee": "tsx scripts/delete-employee-with-relations.ts",
    "delete:all-employees": "tsx scripts/delete-employee-with-relations.ts --all",
    "gh:sync:deploy-config": "node scripts/sync-gh-actions-config.mjs",
    "unify-routes:dry-run": "tsx scripts/unify-routes.ts",
    "unify-routes": "tsx scripts/unify-routes.ts --execute",
    "migrate-routes:dry-run": "tsx scripts/migrate-routes.ts",
    "migrate-routes": "tsx scripts/migrate-routes.ts --execute",
    "backup-routes": "tsx scripts/backup-routes.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/metropolis": "^5.2.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-router/dev": "7.17.0",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.17.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@types/d3": "^7.4.3",
    "@types/recharts": "^1.8.29",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^8.2.0",
    "isbot": "^5.1.17",
    "lucide-react": "^0.488.0",
    "mongoose": "^9.6.3",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.4",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-pdf": "^10.3.0",
    "react-rnd": "^10.5.2",
    "react-router": "7.17.0",
    "react-router-dom": "7.17.0",
    "recharts": "^3.2.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/react-vite": "^10.4.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.25",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^14.26.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.59.1",
    "react-router-devtools": "^1.1.0",
    "storybook": "^10.4.3",
    "tailwindcss": "^4.1.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^4.0.10"
  }
}
