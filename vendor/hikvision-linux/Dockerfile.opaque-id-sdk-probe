# Linux HCNetSDK dry-run probe image (opaque log id mapping).
# Host network recommended so the container can reach device LAN IP.
FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy probe source + vendored SDK (linux64)
COPY opaque_id_sdk_probe.cpp /app/opaque_id_sdk_probe.cpp
COPY scripts/build-opaque-id-sdk-probe.sh /app/scripts/build-opaque-id-sdk-probe.sh
COPY sdk-local/hcnetsdk-6.1.9.48/EN-HCNetSDKV6.1.9.48_build20230410_linux64 /app/sdk

ENV HIKVISION_LINUX_SDK_ROOT=/app/sdk
RUN chmod +x /app/scripts/build-opaque-id-sdk-probe.sh \
  && /app/scripts/build-opaque-id-sdk-probe.sh

# Default: dry-run probe (device.spec + evidence mounted at runtime)
ENTRYPOINT ["/app/build/opaque-id-sdk-probe"]
CMD ["--device-file", "/run/device.spec", "--evidence-dir", "/out", "--max-log-rows", "40"]
