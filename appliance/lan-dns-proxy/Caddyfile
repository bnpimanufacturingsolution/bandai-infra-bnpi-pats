# Project Truth LAN reverse proxy GÇö same-origin /api path routing
# Public Cloudflare *.bnpi-hris.tech is separate and must stay active.

http://dev.bnpi-hris.lan {
	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

http://dev-api.bnpi-hris.lan {
	reverse_proxy 127.0.0.1:3101
}

http://uat.bnpi-hris.lan {
	handle /api/* {
		reverse_proxy 127.0.0.1:3201
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3201
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}

http://uat-api.bnpi-hris.lan {
	reverse_proxy 127.0.0.1:3201
}

http://app.bnpi-hris.lan, http://bnpi-hris.lan {
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

http://api.bnpi-hris.lan {
	reverse_proxy 127.0.0.1:3001
}

http://grafana.bnpi-hris.lan {
	reverse_proxy 127.0.0.1:53000
}
