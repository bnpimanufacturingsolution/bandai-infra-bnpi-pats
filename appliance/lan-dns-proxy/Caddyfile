# PROD apex + www + app
bnpi-pats.lan, www.bnpi-pats.lan, app.bnpi-pats.lan {
	tls internal
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

http://bnpi-pats.lan, http://www.bnpi-pats.lan, http://app.bnpi-pats.lan {
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

api.bnpi-pats.lan {
	tls internal
	reverse_proxy 127.0.0.1:3001
}

http://api.bnpi-pats.lan {
	reverse_proxy 127.0.0.1:3001
}

