# Project Truth LAN reverse proxy — one-to-one with public *.bnpipats.tech
# Zone: *.bnpi-pats.lan (not .local)
# HTTPS: Caddy tls internal (local CA). HTTP also served.
# Public Cloudflare tunnel is separate and must stay active.

{
	auto_https disable_redirects
	local_certs
}

# DEV app + same-origin API
dev.bnpi-pats.lan {
	tls internal
	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

http://dev.bnpi-pats.lan {
	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3101
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

dev-api.bnpi-pats.lan {
	tls internal
	reverse_proxy 127.0.0.1:3101
}

http://dev-api.bnpi-pats.lan {
	reverse_proxy 127.0.0.1:3101
}

