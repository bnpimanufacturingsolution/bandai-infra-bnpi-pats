{
  "title": "Business Dashboard",
  "uid": "business",
  "tags": ["business", "metrics"],
  "panels": [
    {
      "title": "User Registrations (Daily)",
      "targets": [
        {
          "expr": "sum(increase(bnpi_pats_users_registered_total[1d]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "type": "stat"
    },
    {
      "title": "Transactions Completed",
      "targets": [
        {
          "expr": "sum(rate(bnpi_pats_transactions_completed_total[5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "type": "stat"
    },
    {
      "title": "Orders Created (Daily)",
      "targets": [
        {
          "expr": "sum(increase(bnpi_pats_orders_created_total[1d]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "type": "stat"
    },
    {
      "title": "LMS Course Completions",
      "targets": [
        {
          "expr": "sum(rate(bnpi_pats_lms_course_completions_total[5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "type": "stat"
    },
    {
      "title": "Performance Evaluation Submissions",
      "targets": [
        {
          "expr": "sum(rate(bnpi_pats_performance_evaluations_submitted_total[5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "type": "stat"
    },
    {
      "title": "User Activity Trends",
      "targets": [
        {
          "expr": "sum(rate(bnpi_pats_user_activity_total[5m])) by (activity_type)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "type": "timeseries"
    }
  ],
  "schemaVersion": 37,
  "version": 1,
  "time": { "from": "now-30d", "to": "now" }
}
