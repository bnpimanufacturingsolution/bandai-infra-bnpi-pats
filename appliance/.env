# Persistent storage for Grafana, Loki, Tempo, Prometheus (LGTM stack)
# This ensures logs, metrics, traces and dashboards survive docker restarts
OBSERVABILITY_DATA_ROOT=C:/hris-observability

# Ports
GRAFANA_HOST_PORT=53000
PROMETHEUS_HOST_PORT=9091
LOKI_HOST_PORT=3110
TEMPO_HOST_PORT=3200
ALERTMANAGER_HOST_PORT=9093

# Grafana auth
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:53000

# Backup configuration
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_ROLLING=24
BACKUP_KEEP_FULL=7
FULL_FREQUENCY=daily
REMOTE_REPLICATION_ENABLED=false

# Windows reserves 4371 on this host; use an available sidecar status port.
ZKTECO_BRIDGE_STATUS_URL_DEV=http://host.docker.internal:5471/status
