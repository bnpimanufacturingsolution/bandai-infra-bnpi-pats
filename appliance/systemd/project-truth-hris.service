[Unit]
Description=Project Truth HRIS Docker services
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/project-truth/appliance
Environment=PROJECT_TRUTH_QUIET_STARTUP=true
Environment=PROJECT_TRUTH_FIRSTBOOT_SEED=true
ExecStart=/usr/local/bin/project-truth-hris-env-start all
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
