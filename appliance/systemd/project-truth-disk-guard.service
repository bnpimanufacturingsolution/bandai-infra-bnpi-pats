[Unit]
Description=Project Truth disk guard (safe prune + free-space check)
Documentation=file:///usr/local/share/project-truth/project-truth-disk-guard.sh
After=local-fs.target
Wants=local-fs.target
# Never depend on or order against cloudflared. This unit must not stop tunnels.

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/project-truth/disk-guard.env
# Default apply mode. Override DISK_GUARD_APPLY=0 for report-only via env.
ExecStart=/usr/local/bin/project-truth-disk-guard --apply
# Exit 1 = warning threshold; still a successful timer tick for observability.
# Exit 2 = critical; mark service failed so journal/alerts notice.
SuccessExitStatus=0 1
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
