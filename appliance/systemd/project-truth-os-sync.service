[Unit]
Description=Project Truth OS-level Git sync
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=PROJECT_TRUTH_REPO_URL=https://github.com/bnpimanufacturingsolution/bandai-infra-bnpi-pats.git
Environment=PROJECT_TRUTH_BRANCH=develop
EnvironmentFile=-/etc/project-truth/os-sync.env
ExecStart=/usr/local/bin/project-truth-os-sync
