[Unit]
Description=Project Truth disk guard timer (daily + 6h safety)
Documentation=file:///usr/local/share/project-truth/project-truth-disk-guard.sh

[Timer]
# Daily primary window with jitter, shortly after boot, and 6h safety so
# observability rolling archives cannot refill for a full day unchecked.
OnCalendar=*-*-* 04:30:00
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=30min
Persistent=true
Unit=project-truth-disk-guard.service

[Install]
WantedBy=timers.target
