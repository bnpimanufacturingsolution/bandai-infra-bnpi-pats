#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: project-truth-node
    username: infra
    password: "$6$infra$/Xk9fP//Js1CXfJveVZk1PApWrqet1.6PWMEDKFGfadhgTopkMeihkQOYMg08Xd1InSB8YB9x3RaFakaonxRL."
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - openssh-server
    - curl
    - ca-certificates
    - gnupg
    - lsb-release
    - linux-virtual
    - linux-cloud-tools-virtual
    - linux-tools-virtual
  late-commands:
    - mkdir -p /target/etc/ssh/sshd_config.d
    - printf 'PasswordAuthentication yes\nKbdInteractiveAuthentication yes\n' > /target/etc/ssh/sshd_config.d/90-packer-password-auth.conf
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable hv-kvp-daemon hv-vss-daemon hv-fcopy-daemon
    - curtin in-target --target=/target -- usermod -aG sudo infra
    - echo 'infra ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-infra
    - chmod 440 /target/etc/sudoers.d/90-infra
