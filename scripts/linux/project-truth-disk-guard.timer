[Unit]
Description=Project Truth disk guard timer (daily + 6h safety)
Documentation=file:///usr/local/share/project-truth/project-truth-disk-guard.sh
Requires=project-truth-disk-guard.service

[Timer]
# Daily primary window (offset from common 03:00 jobs).
OnCalendar=*-*-* 03:17:00
# Catch-up after boot and mid-day safety without waiting a full day.
OnBootSec=10min
OnUnitActiveSec=6h
Persistent=true
RandomizedDelaySec=10min
Unit=project-truth-disk-guard.service

[Install]
WantedBy=timers.target
