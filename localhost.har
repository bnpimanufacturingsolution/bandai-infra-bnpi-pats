            "text": "import { hrisApiClient } from \"/app/lib/api-client.ts?t=1784264382629\";\nimport { APIService } from \"/app/services/api-service.ts\";\nclass NotificationsService extends APIService {\n  /**\n   * Get all notifications with optional filters\n   */\n  async getNotifications() {\n    try {\n      const queryString = this.getQueryString();\n      const endpoint = `/api/notification${queryString}`;\n      const response = await hrisApiClient.get(endpoint);\n      let notificationsData = response.data;\n      if (notificationsData && typeof notificationsData === \"object\" && \"data\" in notificationsData) {\n        notificationsData = notificationsData.data;\n      }\n      if (!notificationsData) {\n        return { notifications: [] };\n      }\n      return notificationsData;\n    } catch (error) {\n      console.error(\"Error fetching notifications:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error fetching notifications\"\n      );\n    }\n  }\n  /**\n   * Get a single notification by ID\n   */\n  async getNotificationById(id) {\n    try {\n      const response = await hrisApiClient.get(`/api/notification/${id}`);\n      let notificationData = response.data;\n      if (notificationData && typeof notificationData === \"object\" && \"data\" in notificationData) {\n        notificationData = notificationData.data;\n      }\n      if (!notificationData) {\n        throw new Error(\"Notification not found\");\n      }\n      return notificationData;\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error fetching notification\"\n      );\n    }\n  }\n  /**\n   * Create a new notification\n   */\n  async createNotification(data) {\n    try {\n      const response = await hrisApiClient.post(\"/api/notification\", data);\n      let notificationData = response.data;\n      if (notificationData && typeof notificationData === \"object\" && \"data\" in notificationData) {\n        notificationData = notificationData.data;\n      }\n      if (!notificationData) {\n        throw new Error(\"Failed to create notification\");\n      }\n      return notificationData;\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error creating notification\"\n      );\n    }\n  }\n  /**\n   * Update a notification (mark as read, etc.)\n   */\n  async updateNotification(id, data) {\n    try {\n      const response = await hrisApiClient.put(`/api/notification/${id}`, data);\n      let notificationData = response.data;\n      if (notificationData && typeof notificationData === \"object\" && \"data\" in notificationData) {\n        notificationData = notificationData.data;\n      }\n      if (!notificationData) {\n        throw new Error(\"Failed to update notification\");\n      }\n      return notificationData;\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error updating notification\"\n      );\n    }\n  }\n  /**\n   * Mark a notification as read for a specific employee\n   */\n  async markAsRead(id, employeeId) {\n    try {\n      const response = await hrisApiClient.post(\n        `/api/notification/${id}/mark-read`,\n        { employeeId }\n      );\n      let notificationData = response.data;\n      if (notificationData && typeof notificationData === \"object\" && \"data\" in notificationData) {\n        notificationData = notificationData.data;\n      }\n      if (!notificationData) {\n        throw new Error(\"Failed to mark notification as read\");\n      }\n      return notificationData.notification || notificationData;\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error marking notification as read\"\n      );\n    }\n  }\n  /**\n   * Mark multiple notifications as read for a specific employee\n   */\n  async markMultipleAsRead(ids, employeeId) {\n    try {\n      await Promise.all(ids.map((id) => this.markAsRead(id, employeeId)));\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error marking notifications as read\"\n      );\n    }\n  }\n  /**\n   * Delete a notification\n   */\n  async deleteNotification(id) {\n    try {\n      await hrisApiClient.delete(`/api/notification/${id}`);\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error deleting notification\"\n      );\n    }\n  }\n  /**\n   * Get unread notification count for an employee\n   */\n  async getUnreadCount(employeeId) {\n    try {\n      const response = await hrisApiClient.get(\n        `/api/notification?recipientEmployeeId=${encodeURIComponent(employeeId)}&unreadOnly=true&count=true&document=false`\n      );\n      let data = response.data;\n      if (data && typeof data === \"object\" && \"data\" in data) {\n        data = data.data;\n      }\n      return data?.count || 0;\n    } catch (error) {\n      console.error(\"Error fetching unread count:\", error);\n      return 0;\n    }\n  }\n}\nconst notificationsService = new NotificationsService();\nexport default notificationsService;\n\n//# sourceMappingURL=data:application/json;base64,"
