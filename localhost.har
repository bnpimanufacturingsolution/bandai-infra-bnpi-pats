            "mimeType": "text/javascript",
            "text": "import { hrisApiClient } from \"/app/lib/api-client.ts?t=1784264382629\";\nimport { APIService } from \"/app/services/api-service.ts\";\nclass MetricsService extends APIService {\n  async getActionMetrics(employeeId) {\n    try {\n      const query = employeeId ? `?employeeId=${encodeURIComponent(employeeId)}` : \"\";\n      const response = await hrisApiClient.get(`/api/metrics/actions${query}`);\n      const payload = response.data?.data || response.data;\n      if (!payload) {\n        throw new Error(\"Failed to fetch action metrics\");\n      }\n      return payload;\n    } catch (error) {\n      console.error(\"Error fetching action metrics:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error fetching action metrics\"\n      );\n    }\n  }\n  extractMetricsData(response) {\n    let metricsData = response?.data;\n    if (!metricsData && response && typeof response === \"object\") {\n      if (\"metrics\" in response) {\n        metricsData = response;\n      } else if (\"data\" in response) {\n        metricsData = response.data;\n      }\n    }\n    return metricsData;\n  }\n  /**\n   * Get attendance metrics for an employee\n   * @param employeeId Employee ID\n   * @param dateFrom Start date (YYYY-MM-DD)\n   * @param dateTo End date (YYYY-MM-DD)\n   * @returns Promise<MetricsResponse> - Metrics response with attendance data\n   */\n  async getAttendanceMetrics(employeeId, dateFrom, dateTo) {\n    try {\n      const payload = {\n        model: \"Attendance\",\n        data: [\"todayAttendance\"],\n        filter: {\n          employeeId,\n          ...dateFrom && { dateFrom },\n          ...dateTo && { dateTo }\n        }\n      };\n      const response = await hrisApiClient.post(\"/api/metrics\", payload);\n      const metricsData = this.extractMetricsData(response);\n      if (!metricsData || !metricsData.metrics) {\n        throw new Error(\"Failed to fetch attendance metrics\");\n   