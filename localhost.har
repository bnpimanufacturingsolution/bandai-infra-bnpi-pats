            "text": "import { useMutation, useQuery } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=7ae9ac0f\";\nimport { hikvisionService } from \"/app/services/hikvision.service.ts?t=1784264382629\";\nexport function useHikvisionUserSearch(params = {}) {\n  const {\n    deviceId,\n    searchID = \"1\",\n    searchResultPosition = 0,\n    maxResults = 100,\n    enabled = true\n  } = params;\n  const { data, isLoading, error, refetch } = useQuery({\n    queryKey: [\"hikvision\", \"user-search\", deviceId, searchID, searchResultPosition, maxResults],\n    queryFn: () => hikvisionService.searchUserInfo(searchID, searchResultPosition, maxResults, deviceId),\n    enabled,\n    staleTime: 5 * 60 * 1e3,\n    // 5 minutes\n    retry: 2\n  });\n  return {\n    data,\n    isLoading,\n    error,\n    refetch\n  };\n}\nexport function useHikvisionUserSearchMutation() {\n  return useMutation({\n    mutationFn: (params) => hikvisionService.searchUserInfo(\n      params.searchID || \"1\",\n      params.searchResultPosition || 0,\n      params.maxResults || 10,\n      params.deviceId\n    )\n  });\n}\nexport function useHikvisionDeviceUsers(deviceId, enabled = true) {\n  return useQuery({\n    queryKey: [\"hikvision\", \"device-users\", deviceId],\n    queryFn: () => hikvisionService.searchAllUsers(deviceId),\n    enabled: Boolean(deviceId) && enabled,\n    staleTime: 30 * 1e3,\n    retry: 1\n  });\n}\nexport function useAcsEvents(params) {\n  const { acsEventCond, deviceId, enabled = true } = params;\n  const { data, isLoading, error, refetch } = useQuery({\n    queryKey: [\n      \"hikvision\",\n      \"acs-events\",\n      acsEventCond.searchID,\n      acsEventCond.startTime,\n      acsEventCond.endTime,\n      acsEventCond.searchResultPosition,\n      acsEventCond.maxResults,\n      deviceId\n    ],\n    queryFn: () => hikvisionService.getAcsEvents(acsEventCond, deviceId),\n    enabled,\n    staleTime: 2 * 60 * 1e3,\n    // 2 minutes\n    refetchInterval: enabled ? 30 * 1e3 : false,\n    retry: 2\n  });\n  return {\n    data,\n    isLoading,\n    error,\n    refetch\n  };\n}\nexport function useAcsEventsMutation() {\n  return useMutation({\n    mutationFn: (params) => hikvisionService.getAcsEvents(params.acsEventCond, params.deviceId)\n  });\n}\n\n//# sourceMappingURL=data:application/json;base64,"
