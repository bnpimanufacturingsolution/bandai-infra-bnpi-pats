            "size": 18593,
            "mimeType": "text/javascript",
            "text": "import { useMutation, useQuery, useQueryClient } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=7ae9ac0f\";\nimport { toast } from \"/node_modules/.vite/deps/sonner.js?v=7ae9ac0f\";\nimport systemProvisioningService, {\n} from \"/app/services/system-provisioning.service.ts?t=1784264382629\";\nexport const systemProvisioningQueryKeys = {\n  all: [\"system-provisioning\"],\n  status: () => [...systemProvisioningQueryKeys.all, \"status\"],\n  preview: () => [...systemProvisioningQueryKeys.all, \"preview\"],\n  timesheetSettings: () => [...systemProvisioningQueryKeys.all, \"timesheet-settings\"],\n  payrollSettings: () => [...systemProvisioningQueryKeys.all, \"payroll-settings\"],\n  leaveSettings: () => [...systemProvisioningQueryKeys.all, \"leave-settings\"]\n};\nexport const useSystemProvisioningStatus = (enabled = true) => useQuery({\n  queryKey: systemProvisioningQueryKeys.status(),\n  queryFn: () => systemProvisioningService.getStatus(),\n  enabled,\n  staleTime: 30 * 1e3,\n  retry: false\n});\nexport const useBootstrapAdmin = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (payload) => systemProvisioningService.bootstrapAdmin(payload),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"Bootstrap admin created successfully\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to create bootstrap admin\");\n    }\n  });\n};\nexport const useSystemProvisioningPreview = (enabled = true) => useQuery({\n  queryKey: systemProvisioningQueryKeys.preview(),\n  queryFn: () => systemProvisioningService.getPreview(),\n  enabled,\n  staleTime: 30 * 1e3,\n  retry: false\n});\nexport const useInitializeSystemProvisioning = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (payload) => systemProvisioningService.initialize(payload),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"System initialized successfully\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to initialize system\");\n    }\n  });\n};\nexport const useUpdateProvisioningHrSettings = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (payload) => systemProvisioningService.updateHrSettings(payload),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"HR setup values saved\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to save HR setup values\");\n    }\n  });\n};\nexport const useProvisioningTimesheetSettings = (enabled = true) => useQuery({\n  queryKey: systemProvisioningQueryKeys.timesheetSettings(),\n  queryFn: () => systemProvisioningService.getTimesheetSettings(),\n  enabled,\n  retry: false\n});\nexport const useUpdateProvisioningTimesheetSettings = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (payload) => systemProvisioningService.updateTimesheetSettings(payload),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"Timesheet settings saved\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to save timesheet settings\");\n    }\n  });\n};\nexport const useProvisioningPayrollSettings = (enabled = true) => useQuery({\n  queryKey: systemProvisioningQueryKeys.payrollSettings(),\n  queryFn: () => systemProvisioningService.getPayrollSettings(),\n  enabled,\n  retry: false\n});\nexport const useUpdateProvisioningPayrollSettings = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (payload) => systemProvisioningService.updatePayrollSettings(payload),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"Payroll settings saved\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to save payroll settings\");\n    }\n  });\n};\nexport const useProvisioningLeaveSettings = (enabled = true) => useQuery({\n  queryKey: systemProvisioningQueryKeys.leaveSettings(),\n  queryFn: () => systemProvisioningService.getLeaveSettings(),\n  enabled,\n  retry: false\n});\nexport const useUpdateProvisioningLeaveSettings = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: (policies) => systemProvisioningService.updateLeaveSettings(policies),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"Leave settings saved\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to save leave settings\");\n    }\n  });\n};\nexport const useActivateSystemProvisioning = () => {\n  const queryClient = useQueryClient();\n  return useMutation({\n    mutationFn: () => systemProvisioningService.activate(),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: systemProvisioningQueryKeys.all });\n      toast.success(\"System setup activated\");\n    },\n    onError: (error) => {\n      toast.error(error?.message || \"Failed to activate system setup\");\n    }\n  });\n};\n\n//# sourceMappingURL=data:application/json;base64,"
