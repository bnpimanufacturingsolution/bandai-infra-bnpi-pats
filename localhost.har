          "content": {
            "size": 8671,
            "mimeType": "text/javascript",
            "text": "export const resolveDeviceReachabilityStatus = (input) => {\n  if (input.isLoading) return \"checking\";\n  if (input.isError) return \"unknown\";\n  const status = String(input.summaryStatus || \"\").trim().toLowerCase();\n  if (status === \"online\") return \"online\";\n  if (status === \"degraded\") return \"degraded\";\n  if (status === \"offline\") return \"offline\";\n  return \"unknown\";\n};\nexport const getDeviceReachabilityLabel = (status) => {\n  switch (status) {\n    case \"online\":\n      return \"Online\";\n    case \"degraded\":\n      return \"Degraded\";\n    case \"offline\":\n      return \"Offline\";\n    case \"checking\":\n      return \"Checking…\";\n    default:\n      return \"Unknown\";\n  }\n};\nexport const getDeviceReachabilityDotClass = (status) => {\n  switch (status) {\n    case \"online\":\n      return \"bg-emerald-500\";\n    case \"degraded\":\n      return \"bg-amber-500\";\n    case \"offline\":\n      return \"bg-red-500\";\n    case \"checking\":\n      return \"bg-slate-300 animate-pulse\";\n    default:\n      return \"bg-slate-400\";\n  }\n};\nexport const getDeviceReachabilityBadgeClass = (status) => {\n  switch (status) {\n    case \"online\":\n      return \"border-emerald-200 bg-emerald-50 text-emerald-800\";\n    case \"degraded\":\n      return \"border-amber-200 bg-amber-50 text-amber-900\";\n    case \"offline\":\n      return \"border-red-200 bg-red-50 text-red-800\";\n    case \"checking\":\n      return \"border-slate-200 bg-slate-50 text-slate-600\";\n    default:\n      return \"border-slate-200 bg-slate-50 text-slate-600\";\n  }\n};\nexport const buildDeviceReachabilitySummary = (input) => {\n  const status = resolveDeviceReachabilityStatus(input);\n  let detail = null;\n  if (status === \"online\") {\n    detail = \"Device is reachable from HRIS\";\n  } else if (status === \"degraded\") {\n    detail = \"Partially reachable — some checks failed\";\n  } else if (status === \"offline\") {\n    detail = input.networkOk === false ? \"Network unreachable\" : input.deviceApiOk === false ? \"Device API not responding\" : \"Device appears offline\";\n  } else if (status === \"checking\") {\n    detail = \"Checking reachability…\";\n  } else if (input.errorMessage) {\n    detail = input.errorMessage;\n  } else {\n    detail = \"Status not checked yet\";\n  }\n  return {\n    status,\n    label: getDeviceReachabilityLabel(status),\n    checkedAt: input.checkedAt || null,\n    detail\n  };\n};\n\n//# sourceMappingURL=data:application/json;base64,"
