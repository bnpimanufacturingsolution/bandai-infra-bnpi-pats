${token}` } : {}\n      });\n      if (!response.ok) {\n        let message = \"Failed to load device user photo\";\n        try {\n          const data = await response.json();\n          message = data?.message || data?.error || message;\n        } catch {\n        }\n        throw new Error(message);\n      }\n      return await response.blob();\n    } catch (error) {\n      console.error(\"Error loading device user photo:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error loading device user photo\"\n      );\n    }\n  }\n  /**\n   * Search devices by name or address\n   * @param query Search term\n   * @param params Optional query parameters\n   * @returns Promise<DevicesResponse> - Devices response\n   */\n  async searchDevices(query, params) {\n    return this.search(query).setParams(params || {}).getDevices();\n  }\n  /**\n   * Get devices grouped by a specific field\n   * @param groupBy Field to group by\n   * @param params Optional query parameters\n   * @returns Promise<DevicesResponse> - Devices response\n   */\n  async getDevicesGrouped(groupBy, params) {\n    return this.setParams({\n      ...params,\n      groupBy\n    }).getDevices();\n  }\n  /**\n   * Enroll a single user to device and sync employee.deviceEmpId\n   */\n  async enrollDeviceUser(payload) {\n    try {\n      const response = await hrisApiClient.post(\"/api/device/enroll\", payload);\n      if (!response.data) {\n        throw new Error(\"Failed to enroll user to device\");\n      }\n      return response.data;\n    } catch (error) {\n      console.error(\"Error enrolling user to device:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error enrolling user to device\"\n      );\n    }\n  }\n  async copyHikvisionDeviceUserToPeer(payload) {\n    try {\n      const response = await hrisApiClient.post(\n        \"/api/device/hikvision/copy-user\",\n        payload\n      );\n      if (!response.data) {\n        throw new Error(\"Failed to copy Hikvision device user\");\n      }\n      return response.data?.data || response.data;\n    } catch (error) {\n      console.error(\"Error copying Hikvision device user:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error copying Hikvision device user\"\n      );\n    }\n  }\n  async mirrorHikvisionFaceToPeers(payload) {\n    try {\n      const response = await hrisApiClient.post(\n        \"/api/device/hikvision/mirror-face\",\n        payload\n      );\n      if (!response.data) throw new Error(\"Failed to mirror Hikvision face\");\n      return response.data?.data || response.data;\n    } catch (error) {\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Failed to mirror Hikvision face\"\n      );\n    }\n  }\n  async mockHikvisionFingerprintTally(payload) {\n    try {\n      const response = await hrisApiClient.post(\n        \"/api/device/hikvision/mock-fingerprint\",\n        payload\n      );\n      if (!response.data) {\n        throw new Error(\"Failed to apply synthetic fingerprint tally\");\n      }\n      return response.data?.data || response.data;\n    } catch (error) {\n      console.error(\"Error applying synthetic fingerprint tally:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error applying synthetic fingerprint tally\"\n      );\n    }\n  }\n  async mockHikvisionFaceTally(payload) {\n    try {\n      const response = await hrisApiClient.post(\n        \"/api/device/hikvision/mock-face\",\n        payload\n      );\n      if (!response.data) {\n        throw new Error(\"Failed to apply synthetic face tally\");\n      }\n      return response.data?.data || response.data;\n    } catch (error) {\n      console.error(\"Error applying synthetic face tally:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error applying synthetic face tally\"\n      );\n    }\n  }\n  async triggerZktecoAttendanceSync(payload = {}) {\n    try {\n      const response = await hrisApiClient.post(\"/api/device/zkteco/sync\", payload);\n      if (!response.data) {\n        throw new Error(\"Failed to start ZKTeco sync\");\n      }\n      return response.data;\n    } catch (error) {\n      console.error(\"Error starting ZKTeco sync:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error starting ZKTeco sync\"\n      );\n    }\n  }\n  async triggerHikvisionAttendanceImport(payload) {\n    try {\n      const response = await hrisApiClient.post(\"/api/device/hikvision/sync\", payload);\n      if (!response.data) {\n        throw new Error(\"Failed to start device log sync\");\n      }\n      return response.data?.data || response.data;\n    } catch (error) {\n      console.error(\"Error starting Hikvision sync:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error starting device log sync\"\n      );\n    }\n  }\n  async getDeviceImportJob(jobId) {\n    try {\n      if (!String(jobId || \"\").trim()) throw new Error(\"Import job is required\");\n      const response = await hrisApiClient.get(`/api/device/import-jobs/${jobId}`);\n      const progress = response.data?.data || response.data;\n      if (!progress) throw new Error(\"Import job was not found\");\n      return progress;\n    } catch (error) {\n      console.error(\"Error loading device import job:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error loading import progress\"\n      );\n    }\n  }\n  async cancelDeviceImportJob(jobId) {\n    try {\n      if (!String(jobId || \"\").trim()) throw new Error(\"Import job is required\");\n      const response = await hrisApiClient.post(\n        `/api/device/import-jobs/${jobId}/cancel`,\n        {}\n      );\n      const progress = response.data?.data || response.data;\n      if (!progress) throw new Error(\"Import job was not found\");\n      return progress;\n    } catch (error) {\n      console.error(\"Error cancelling device import job:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error cancelling import job\"\n      );\n    }\n  }\n  async resetDeviceEvents(payload) {\n    try {\n      const response = await hrisApiClient.post(\"/api/device/events/reset\", payload);\n      const data = response.data?.data || response.data;\n      if (!data) throw new Error(\"Failed to reset saved device events\");\n      return data;\n    } catch (error) {\n      console.error(\"Error resetting device events:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error resetting saved device events\"\n      );\n    }\n  }\n  async getHikvisionListenerStatus() {\n    try {\n      const response = await hrisApiClient.get(\"/api/device/hikvision/listener\", {\n        timeoutMs: 8e3\n      });\n      const data = response.data?.data || response.data;\n      if (!data) throw new Error(\"Failed to load Hikvision listener status\");\n      return data;\n    } catch (error) {\n      console.error(\"Error loading Hikvision listener status:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error loading Hikvision listener status\"\n      );\n    }\n  }\n  async controlHikvisionListener(action) {\n    try {\n      const response = await hrisApiClient.post(\"/api/device/hikvision/listener\", {\n        action\n      });\n      const data = response.data?.data || response.data;\n      if (!data) throw new Error(\"Failed to control Hikvision listener\");\n      return data;\n    } catch (error) {\n      console.error(\"Error controlling Hikvision listener:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error controlling Hikvision listener\"\n      );\n    }\n  }\n  /**\n   * Import device enrollment data from a file\n   * @param file File to import (CSV/XLSX)\n   * @returns Promise<any> - Import summary\n   */\n  async importDeviceEnrollment(file) {\n    try {\n      const formData = new FormData();\n      formData.append(\"file\", file);\n      const response = await hrisApiClient.post(\"/api/device/enroll/import\", formData);\n      if (!response.data) {\n        throw new Error(\"Failed to import device enrollment\");\n      }\n      return response.data;\n    } catch (error) {\n      console.error(\"Error importing device enrollment:\", error);\n      throw new Error(\n        error.data?.errors?.[0]?.message || error.message || \"Error importing device enrollment\"\n      );\n    }\n  }\n}\nconst devicesService = new DevicesService();\nexport default devicesService;\n\n//# sourceMappingURL=data:application/json;base64,"
