            "size": 77684,
            "mimeType": "text/javascript",
            "text": "import { useQuery } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=7ae9ac0f\";\nimport { useAuth } from \"/app/lib/hooks/use-auth.ts\";\nimport metricsService, {\n} from \"/app/services/metrics.service.ts?t=1784264382629\";\nexport const queryKeys = {\n  metrics: {\n    all: [\"metrics\"],\n    generic: (model, data, filter) => [...queryKeys.metrics.all, \"generic\", model, data, filter],\n    attendance: (employeeId, dateFrom, dateTo) => [...queryKeys.metrics.all, \"attendance\", employeeId, dateFrom, dateTo],\n    statusSummary: (dateFrom, dateTo) => [...queryKeys.metrics.all, \"statusSummary\", dateFrom, dateTo],\n    employeeStatusSummary: (reportToId, dateFrom, dateTo) => [\n      ...queryKeys.metrics.all,\n      \"employeeStatusSummary\",\n      reportToId,\n      dateFrom,\n      dateTo\n    ],\n    birthdaysSummary: (organizationId) => [...queryKeys.metrics.all, \"birthdaysSummary\", organizationId],\n    documentCompliance: (organizationId, departmentId, sectionId, reportToId) => [\n      ...queryKeys.metrics.all,\n      \"documentCompliance\",\n      organizationId,\n      departmentId,\n      sectionId,\n      reportToId\n    ],\n    actionMetrics: (employeeId) => [...queryKeys.metrics.all, \"actionMetrics\", employeeId || \"self\"],\n    payrollBlockers: (payrollPeriodId, scope) => [\n      ...queryKeys.metrics.all,\n      \"payrollBlockers\",\n      payrollPeriodId,\n      scope?.departmentId || null,\n      scope?.sectionId || null\n    ],\n    payrollRunSummary: (payrollPeriodId, scope) => [\n      ...queryKeys.metrics.all,\n      \"payrollRunSummary\",\n      payrollPeriodId,\n      scope?.departmentId || null,\n      scope?.sectionId || null\n    ],\n    attendanceMetricsDetailed: (dateFrom, dateTo, limit, page, search, status, departmentId, sectionId, positionId, levelId, reportToId, employeeId, shiftType) => [\n      ...queryKeys.metrics.all,\n      \"attendanceMetricsDetailed\",\n      dateFrom,\n      dateTo,\n      limit,\n      page,\n      search,\n      status,\n      departmentId,\n      sectionId,\n      positionId,\n      levelId,\n      reportToId,\n      employeeId,\n      shiftType\n    ],\n    attendanceTodayOpsSummary: (dateFrom, dateTo, search, departmentId, sectionId, positionId, levelId, reportToId, employeeId, shiftType) => [\n      ...queryKeys.metrics.all,\n      \"attendanceTodayOpsSummary\",\n      dateFrom,\n      dateTo,\n      search,\n      departmentId,\n      sectionId,\n      positionId,\n      levelId,\n      reportToId,\n      employeeId,\n      shiftType\n    ],\n    attendanceTimesheetLineSummary: (dateFrom, dateTo, search, status, departmentId, sectionId, positionId, levelId, reportToId, employeeId, shiftType) => [\n      ...queryKeys.metrics.all,\n      \"attendanceTimesheetLineSummary\",\n      dateFrom,\n      dateTo,\n      search,\n      status,\n      departmentId,\n      sectionId,\n      positionId,\n      levelId,\n      reportToId,\n      employeeId,\n      shiftType\n    ],\n    attendanceObligationSummary: (dateFrom, dateTo, search, status, departmentId, sectionId, positionId, levelId, reportToId, employeeId, shiftType) => [\n      ...queryKeys.metrics.all,\n      \"attendanceObligationSummary\",\n      dateFrom,\n      dateTo,\n      search,\n      status,\n      departmentId,\n      sectionId,\n      positionId,\n      levelId,\n      reportToId,\n      employeeId,\n      shiftType\n    ],\n    attendanceDailyTrendByDepartment: (dateFrom, dateTo, search, status, departmentId, reportToId, employeeId, shiftType) => [\n      ...queryKeys.metrics.all,\n      \"attendanceDailyTrendByDepartment\",\n      dateFrom,\n      dateTo,\n      search,\n      status,\n      departmentId,\n      reportToId,\n      employeeId,\n      shiftType\n    ],\n    timesheetStatistics: (filter) => [...queryKeys.metrics.all, \"timesheetStatistics\", filter],\n    perfectAttendance: (dateFrom, dateTo, departmentId) => [\n      ...queryKeys.metrics.all,\n      \"perfectAttendance\",\n      dateFrom,\n      dateTo,\n      departmentId\n    ],\n    tardinessMetrics: (dateFrom, dateTo, departmentId) => [...queryKeys.metrics.all, \"tardinessMetrics\", dateFrom, dateTo, departmentId],\n    overtimeMetrics: (dateFrom, dateTo, departmentId) => [...queryKeys.metrics.all, \"overtimeMetrics\", dateFrom, dateTo, departmentId],\n    noWorkReport: (dateFrom, departmentId, reportToId) => [...queryKeys.metrics.all, \"noWorkReport\", dateFrom, departmentId, reportToId],\n    dailyActiveManpower: (dateFrom, departmentId, reportToId) => [\n      ...queryKeys.metrics.all,\n      \"dailyActiveManpower\",\n      dateFrom,\n      departmentId,\n      reportToId\n    ],\n    agencyAttendanceSummary: (dateFrom, dateTo, departmentId, reportToId) => [\n      ...queryKeys.metrics.all,\n      \"agencyAttendanceSummary\",\n      dateFrom,\n      dateTo,\n      departmentId,\n      reportToId\n    ],\n    directIndirectLaborSummary: (dateFrom, dateTo, departmentId, reportToId, laborType) => [\n      ...queryKeys.metrics.all,\n      \"directIndirectLaborSummary\",\n      dateFrom,\n      dateTo,\n      departmentId,\n      reportToId,\n      laborType\n    ],\n    payrollSummary: (dateFrom, dateTo, payrollPeriodId, departmentId, reportToId) => [\n      ...queryKeys.metrics.all,\n      \"payrollSummary\",\n      dateFrom,\n      dateTo,\n      payrollPeriodId,\n      departmentId,\n      reportToId\n    ],\n    turnoverAttritionReport: (dateFrom, dateTo, groupBy) => [\n      ...queryKeys.metrics.all,\n      \"turnoverAttritionReport\",\n      dateFrom,\n      dateTo,\n      groupBy\n    ],\n    bir1601CMetrics: (filter) => [...queryKeys.metrics.all, \"bir1601CMetrics\", filter],\n    leaveBalanceMetrics: (filter) => [...queryKeys.metrics.all, \"leaveBalanceMetrics\", filter]\n  }\n};\nexport const useMetrics = (model, data, filter) => {\n  return useQuery({\n    queryKey: queryKeys.metrics.generic(model, data, filter),\n    queryFn: () => metricsSer