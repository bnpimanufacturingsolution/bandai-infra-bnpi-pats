          "content": {
            "size": 62412,
            "mimeType": "text/javascript",
            "text": "import { useQuery, useMutation, useQueryClient } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=7ae9ac0f\";\nimport timesheetService, {\n} from \"/app/services/timesheet.service.ts?t=1784264382629\";\nimport { toast } from \"/node_modules/.vite/deps/sonner.js?v=7ae9ac0f\";\nimport { timesheetlineQueryKeys } from \"/app/lib/hooks/useTimesheetlines.ts?t=1784264382629\";\nexport const timesheetQueryKeys = {\n  timesheets: {\n    all: [\"timesheets\"],\n    lists: () => [...timesheetQueryKeys.timesheets.all, \"list\"],\n    list: (params) => [...timesheetQueryKeys.timesheets.lists(), { params }],\n    hrQueues: (params) => [...timesheetQueryKeys.timesheets.lists(), \"hr-queues\", { params }],\n    details: () => [...timesheetQueryKeys.timesheets.all, \"detail\"],\n    detail: (id) => [...timesheetQueryKeys.timesheets.details(), id],\n    config: () => [...timesheetQueryKeys.timesheets.all, \"config\"]\n  }\n};\nconst getTimesheetErrorMessage = (error, fallback) => {\n  const rawMessage = String(error?.message || \"\").toUpperCase();\n  if (rawMessage.includes(\"POLICY_DISABLED\")) {\n    return \"Timesheet editing is disabled by company policy.\";\n  }\n  if (rawMessage.includes(\"EDIT_PERMISSION_REQUIRED_FOR_RESUBMISSION\")) {\n    return \"Edit permission is required before you can resubmit this timesheet.\";\n  }\n  if (rawMessage.includes(\"NO_CHANGES_TO_RESUBMIT\")) {\n    return \"No changes were detected to resubmit.\";\n  }\n  return error?.message || fallback;\n};\nexport const TIMESHEET_LIST_FIELDS = [\n  \"id\",\n  \"code\",\n  \"status\",\n  \"lockedAt\",\n  \"lockedBy\",\n  \"lockReason\",\n  \"lockRunId\",\n  \"totalHoursWorked\",\n  \"totalRegularHours\",\n  \"totalOvertimeHours\",\n  \"totalUndertimeHours\",\n  \"totalLateHours\",\n  \"totalEarlyOutHours\",\n  \"employeeId\",\n  \"employee.id\",\n  \"employee.employeeId\",\n  \"employee.employeeCode\",\n  \"employee.user.avatar\",\n  \"employee.embeddedSchedule\",\n  \"em