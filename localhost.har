border-radius: 9999px;\\n  border: 1px solid transparent;\\n  background-clip: content-box;\\n}\\n.sidebar-scroll:hover::-webkit-scrollbar-thumb {\\n  background-color: rgba(100, 116, 139, 0.44);\\n}\\n.dark .sidebar-scroll {\\n  scrollbar-color: rgba(148, 163, 184, 0.28) transparent;\\n}\\n.dark .sidebar-scroll::-webkit-scrollbar-thumb {\\n  background-color: rgba(148, 163, 184, 0.28);\\n}\\n:root {\\n  --background: oklch(1 0 0);\\n  --foreground: oklch(0 0 0);\\n  --card: oklch(1 0 0);\\n  --card-foreground: oklch(0 0 0);\\n  --popover: oklch(1 0 0);\\n  --popover-foreground: oklch(0 0 0);\\n  --primary: oklch(0.62 0.24 27);\\n  --primary-foreground: oklch(1 0 0);\\n  --secondary: oklch(0.96 0 0);\\n  --secondary-foreground: oklch(0 0 0);\\n  --muted: oklch(0.92 0 0);\\n  --muted-foreground: oklch(0.4 0 0);\\n  --accent: oklch(0.62 0.24 27);\\n  --accent-foreground: oklch(1 0 0);\\n  --destructive: oklch(0.55 0.22 27);\\n  --destructive-foreground: oklch(1 0 0);\\n  --border: oklch(0.9 0 0);\\n  --input: oklch(0.96 0 0);\\n  --ring: oklch(0.62 0.24 27);\\n  --chart-1: oklch(0.62 0.24 27);\\n  --chart-2: oklch(0.7 0.18 27);\\n  --chart-3: oklch(0.55 0.22 27);\\n  --chart-4: oklch(0.4 0.15 27);\\n  --chart-5: oklch(0.3 0.12 27);\\n  --radius: 0.625rem;\\n  --sidebar: oklch(1 0 0);\\n  --sidebar-foreground: oklch(0 0 0);\\n  --sidebar-primary: oklch(0.62 0.24 27);\\n  --sidebar-primary-foreground: oklch(1 0 0);\\n  --sidebar-accent: oklch(0.96 0 0);\\n  --sidebar-accent-foreground: oklch(0 0 0);\\n  --sidebar-border: oklch(0.9 0 0);\\n  --sidebar-ring: oklch(0.62 0.24 27);\\n  --status-pending: #9ca3af;\\n  --status-in-review: #3b82f6;\\n  --status-processing: #f59e0b;\\n  --status-approved: #22c55e;\\n  --status-rejected: #ef4444;\\n  --status-cancelled: #64748b;\\n  --status-completed: #10b981;\\n}\\n.dark {\\n  --background: oklch(0.1 0 0);\\n  --foreground: oklch(0.98 0 0);\\n  --card: oklch(0.15 0 0);\\n  --card-foreground: oklch(0.98 0 0);\\n  --popover: oklch(0.15 0 0);\\n  --popover-foreground: oklch(0.98 0 0);\\n  --primary: oklch(0.65 0.24 27);\\n  --primary-foreground: oklch(1 0 0);\\n  --secondary: oklch(0.2 0 0);\\n  --secondary-foreground: oklch(0.95 0 0);\\n  --muted: oklch(0.25 0 0);\\n  --muted-foreground: oklch(0.65 0 0);\\n  --accent: oklch(0.65 0.24 27);\\n  --accent-foreground: oklch(1 0 0);\\n  --destructive: oklch(0.6 0.22 27);\\n  --destructive-foreground: oklch(0.98 0 0);\\n  --border: oklch(0.3 0 0);\\n  --input: oklch(0.2 0 0);\\n  --ring: oklch(0.65 0.24 27);\\n  --chart-1: oklch(0.65 0.24 27);\\n  --chart-2: oklch(0.7 0.18 27);\\n  --chart-3: oklch(0.6 0.22 27);\\n  --chart-4: oklch(0.5 0.15 27);\\n  --chart-5: oklch(0.4 0.12 27);\\n  --sidebar: oklch(0.15 0 0);\\n  --sidebar-foreground: oklch(0.98 0 0);\\n  --sidebar-primary: oklch(0.65 0.24 27);\\n  --sidebar-primary-foreground: oklch(1 0 0);\\n  --sidebar-accent: oklch(0.2 0 0);\\n  --sidebar-accent-foreground: oklch(0.95 0 0);\\n  --sidebar-border: oklch(0.3 0 0);\\n  --sidebar-ring: oklch(0.65 0.24 27);\\n}\\n.status-badge {\\n  padding: 0.25rem 0.75rem;\\n  border-radius: 9999px;\\n  border-width: 0;\\n  font-size: 0.75rem;\\n  font-weight: 600;\\n  background-color: var(--status-bg);\\n  color: var(--status-text);\\n  border-color: var(--status-border);\\n}\\n.glassmatic {\\n  background: var(--glass-bg);\\n  backdrop-filter: blur(12px);\\n  -webkit-backdrop-filter: blur(12px);\\n  border: 1px solid var(--glass-border);\\n}\\n.heading-premium {\\n  font-family: var(--font-heading);\\n  letter-spacing: -0.02em;\\n}\\n.text-gradient-bandai {\\n  background: linear-gradient(\\t135deg,\\tvar(--brand-color-primary) 0%,\\tvar(--brand-color-accent) 100%\\t);\\n  -webkit-background-clip: text;\\n  -webkit-text-fill-color: transparent;\\n}\\n.premium-card {\\n  border-radius: var(--radius-2xl);\\n  border-style: var(--tw-border-style);\\n  border-width: 1px;\\n  border-color: var(--color-neutral-200);\\n  background-color: var(--color-white);\\n  tra