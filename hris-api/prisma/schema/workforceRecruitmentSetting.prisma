enum WorkforceRecruitmentLimitBehavior {
  WARN
  BLOCK
}

model WorkforceRecruitmentSetting {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String

  isEnabled                     Boolean   @default(true)
  enforceDepartmentManagerScope Boolean   @default(true)
  defaultWorkflowCode           String    @default("WF-REQUEST-HIRING-REQUISITION-DEFAULT")
  requestSubtype                String    @default("DEPARTMENT_JOB_REQUISITION")
  autoCreateJobOnApproval       Boolean   @default(true)
  seededAt                      DateTime?

  policies  WorkforceRecruitmentPolicy[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([organizationId])
  @@map("workforce_recruitment_settings")
}

model WorkforceRecruitmentPolicy {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  settingId      String  @db.ObjectId
  organizationId String
  departmentId   String? @db.ObjectId
  sectionId      String? @db.ObjectId
  positionId     String? @db.ObjectId
  levelId        String? @db.ObjectId

  targetHeadcount Int                               @default(0)
  limitBehavior   WorkforceRecruitmentLimitBehavior @default(WARN)

  defaultWorkflowCode     String?
  autoCreateJobOnApproval Boolean  @default(true)
  jobType                 String?
  jobLocation             String?
  jobTags                 String[]
  jobDescriptionTemplate  String?
  isActive                Boolean  @default(true)

  setting    WorkforceRecruitmentSetting @relation(fields: [settingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  section    Section?                    @relation(fields: [sectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  position   Position?                   @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  level      Level?                      @relation(fields: [levelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([settingId])
  @@index([organizationId])
  @@index([organizationId, departmentId, sectionId, positionId, levelId, isActive])
  @@map("workforce_recruitment_policies")
}
