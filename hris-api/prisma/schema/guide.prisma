model Guide {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  sections    Json // Stores entire sections array with pages and blocks
  published   Boolean  @default(false)
  author      String?
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([published])
  @@index([author])
  @@map("guides")
}
