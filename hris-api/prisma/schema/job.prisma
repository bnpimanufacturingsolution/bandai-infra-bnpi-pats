model Job {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId     String
  departmentId       String? @db.ObjectId
  sectionId          String? @db.ObjectId
  sourceRequestId    String? @db.ObjectId
  headcountRequested Int     @default(1)

  positionId String   @db.ObjectId
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  levelId String? @db.ObjectId
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  section       Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceRequest Request?    @relation("JobSourceRequest", fields: [sourceRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  tags String[]

  type        String?
  location    String?
  description String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicants Applicant[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([positionId])
  @@index([levelId])
  @@index([sourceRequestId])
}
