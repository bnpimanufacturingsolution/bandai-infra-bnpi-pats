model ScheduleTemplate {
  id                   String                       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId       String
  name                 String
  code                 String
  description          String?
  cycleDays            Int
  graceLateMinutes     Int                          @default(0)
  graceEarlyOutMinutes Int                          @default(0)
  pattern              ScheduleTemplatePatternDay[]
  totalHour            Float                        @default(0)
  totalDay             Int                          @default(0)
  isActive             Boolean                      @default(true)
  isDeleted            Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  departmentScheduleTemplates DepartmentScheduleTemplate[]
  sections                    Section[]

  @@unique([organizationId, code])
  @@index([organizationId, isDeleted])
  @@map("schedule_templates")
}
