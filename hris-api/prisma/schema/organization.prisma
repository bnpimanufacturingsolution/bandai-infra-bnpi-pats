model Organization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  code        String   @unique
  branding    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  users User[]

  @@index([isDeleted])
  @@map("organizations")
}
