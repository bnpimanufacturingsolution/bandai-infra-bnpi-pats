enum Protocol {
  http
  https
  tcp
  udp
}

enum DeviceEventStatus {
  RECEIVED
  MATCHED
  ATTENDANCE_CREATED
  ATTENDANCE_UPDATED
  IGNORED
  UNMATCHED
  FAILED
}

enum DeviceEventSource {
  HIKVISION_CALLBACK
  EN_HCNETSDK_ALARM
}

type Access {
  username String?
  password String?
}

model Device {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String
  name           String
  address        String
  port           Int

  protocol Protocol @default(http)

  config Json?

  access Access

  employees Employee[]
  events    DeviceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([organizationId, address, port])
}

model DeviceEvent {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String
  device         Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId       String            @db.ObjectId
  employeeId     String?           @db.ObjectId
  attendanceId   String?           @db.ObjectId

  eventTime    DateTime
  receivedAt   DateTime          @default(now())
  employeeNo   String?
  source       DeviceEventSource @default(HIKVISION_CALLBACK)
  status       DeviceEventStatus @default(RECEIVED)
  eventType    String?
  major        String?
  minor        String?
  doorNo       String?
  verifyMode   String?
  dedupeKey    String
  payload      Json?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, deviceId, receivedAt])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, source, receivedAt])
  @@index([organizationId, employeeNo, receivedAt])
  @@map("device_events")
}
