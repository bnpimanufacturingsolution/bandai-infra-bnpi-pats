enum BusinessDayRule {
  NONE
  NEXT_BUSINESS_DAY
}

model PayrollCycleConfig {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String

  defaultPayFrequency               PayFrequency    @default(SEMI_MONTHLY)
  payDateOffsetDays                 Int             @default(5)
  businessDayRule                   BusinessDayRule @default(NEXT_BUSINESS_DAY)
  includeHolidaysInBusinessDayCheck Boolean         @default(true)
  cycleRules                        Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("payroll_cycle_configs")
}
