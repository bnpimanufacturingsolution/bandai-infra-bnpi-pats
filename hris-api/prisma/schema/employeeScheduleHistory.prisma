model EmployeeScheduleHistory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String
  employeeId      String    @db.ObjectId
  action          String
  effectiveAt     DateTime?
  actorEmployeeId String?   @db.ObjectId
  reason          String?
  beforeSchedule  Json?
  afterSchedule   Json?
  metadata        Json?
  createdAt       DateTime  @default(now())

  employee Employee  @relation("EmployeeScheduleHistoryTarget", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  actor    Employee? @relation("EmployeeScheduleHistoryActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, employeeId, createdAt])
  @@index([organizationId, employeeId, effectiveAt, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorEmployeeId])
  @@map("employee_schedule_history")
}
