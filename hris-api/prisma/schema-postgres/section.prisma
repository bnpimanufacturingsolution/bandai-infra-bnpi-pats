model Section {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?

  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId String

  head   Employee? @relation("SectionHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  headId String?

  scheduleTemplate ScheduleTemplate? @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scheduleId       String?

  isHr      Boolean  @default(false)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees                    Employee[]
  positions                    Position[]
  jobs                         Job[]
  workforceRecruitmentPolicies WorkforceRecruitmentPolicy[]
  lineLeaders                  SectionLineLeader[]

  @@unique([organizationId, code])
  @@unique([organizationId, departmentId, name])
  @@index([organizationId])
  @@index([organizationId, departmentId, isDeleted])
  @@map("sections")
}
