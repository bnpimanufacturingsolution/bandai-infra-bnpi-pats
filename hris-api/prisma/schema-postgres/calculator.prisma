enum CalculatorType {
  BASIC
  GROSS_TO_NET
  NET_TO_GROSS
  THIRTEENTH_MONTH
  CUSTOM
}

model Calculator {
  id             String         @id @default(cuid())
  organizationId String // Multi-tenancy support
  code           String? // Unique code for calculator (e.g., CALC-DEFAULT-2026)
  name           String
  description    String?
  type           CalculatorType @default(BASIC)

  // Tax and contribution settings
  // Configured based on TRAIN Law patterns (see tax-calculator.helper.ts)
  taxRates Json? // [
  //   {
  //     annualBase: 0,
  //     annualCap: 250000,
  //     annualFixedTax: 0,
  //     monthlyBase: 0,
  //     monthlyCap: 20833,
  //     monthlyFixedTax: 0,
  //     rate: 0
  //   },
  //   {
  //     annualBase: 250000,
  //     annualCap: 400000,
  //     annualFixedTax: 0,
  //     monthlyBase: 20833,
  //     monthlyCap: 33332,
  //     monthlyFixedTax: 0,
  //     rate: 0.15
  //   },
  //   {
  //     annualBase: 400000,
  //     annualCap: 800000,
  //     annualFixedTax: 22500,
  //     monthlyBase: 33333,
  //     monthlyCap: 66666,
  //     monthlyFixedTax: 1875,
  //     rate: 0.2
  //   },
  //   {
  //     annualBase: 800000,
  //     annualCap: 2000000,
  //     annualFixedTax: 102500,
  //     monthlyBase: 66667,
  //     monthlyCap: 166666,
  //     monthlyFixedTax: 8542,
  //     rate: 0.25
  //   },
  //   {
  //     annualBase: 2000000,
  //     annualCap: 8000000,
  //     annualFixedTax: 402500,
  //     monthlyBase: 166667,
  //     monthlyCap: 666666,
  //     monthlyFixedTax: 33542,
  //     rate: 0.3
  //   },
  //   {
  //     annualBase: 8000000,
  //     annualCap: null,
  //     annualFixedTax: 2202500,
  //     monthlyBase: 666667,
  //     monthlyCap: null,
  //     monthlyFixedTax: 183542,
  //     rate: 0.35
  //   }
  // ]

  // SSS Contribution Configuration
  sssRates Json? // {
  //   employeeRate: 0.05,  // 5%
  //   employerRate: 0.1, // 10%
  //   totalRate: 0.15,    // 15%
  //   minimumBase: 250,
  //   maximumCeiling: 1750,
  // }

  // PhilHealth Contribution Configuration
  philHealthRates Json? // {
  //   employeeRate: 0.025, // 2.5%
  //   employerRate: 0.025, // 2.5%
  //   totalRate: 0.05,     // 5%
  //   minimumBase: 250,
  //   maximumCeiling: 2500, // Ceiling for now
  // }

  // PAG-IBIG Contribution Configuration
  pagibigRates Json? // {
  //   rateBelowThreshold: 0.01, // 1% for monthly income 1500 and below
  //   rateAboveThreshold: 0.02, // 2% for monthly income above 1500
  //   threshold: 1500,
  //   maximumCeiling: 200,      // Max contribution (100 employee + 100 employer)
  // }

  // Rate Multipliers for all pay types based on DOLE standards
  // Organized by scenario with work, OT, ND (night diff), and NDOT rates
  rateMultipliers Json? // {
  //   ordinaryDay: {
  //     work: 1.000,  // Work (1st 8h) - 100%
  //     ot: 1.250,    // OT (>8h) - 125%
  //     nd: 1.100,    // ND (10pm-6am) - 110%
  //     ndot: 1.375   // NDOT - 137.5%
  //   },
  //   restDayOrSpecialHoliday: {
  //     work: 1.300,  // 130%
  //     ot: 1.690,    // 169%
  //     nd: 1.430,    // 143%
  //     ndot: 1.859   // 185.9%
  //   },
  //   specialHolidayOnRestDay: {
  //     work: 1.500,  // 150%
  //     ot: 1.950,    // 195%
  //     nd: 1.650,    // 165%
  //     ndot: 2.145   // 214.5%
  //   },
  //   regularHoliday: {
  //     work: 2.000,  // 200%
  //     ot: 2.600,    // 260%
  //     nd: 2.200,    // 220%
  //     ndot: 2.860   // 286%
  //   },
  //   regularHolidayOnRestDay: {
  //     work: 2.600,  // 260%
  //     ot: 3.380,    // 338%
  //     nd: 2.860,    // 286%
  //     ndot: 3.718   // 371.8%
  //   },
  //   doubleHoliday: {
  //     work: 3.000,  // 300%
  //     ot: 3.900,    // 390%
  //     nd: 3.300,    // 330%
  //     ndot: 4.290   // 429%
  //   },
  //   doubleHolidayOnRestDay: {
  //     work: 3.900,  // 390%
  //     ot: 5.070,    // 507%
  //     nd: 4.290,    // 429%
  //     ndot: 5.577   // 557.7%
  //   }
  // }

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payrollPeriods PayrollPeriod[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("calculators")
}
