enum BenefitProgramStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  DEFAULTED
}

enum BenefitDeductionStatus {
  SCHEDULED
  DEDUCTED
  FAILED
  WAIVED
}

enum BenefitScheduleMode {
  TIME_BOUND
  FIXED_INSTALLMENTS
  RECURRING
}

enum BenefitAttendanceAmountBasis {
  PER_DAY
  PER_CUTOFF
}

/// Cadence filter under scheduleMode RECURRING. Null/missing = EVERY_CUTOFF.
enum BenefitRecurrenceFrequency {
  EVERY_CUTOFF
  MONTHLY
  YEARLY
}

/// Whether a period installment may pay based on attendance quality.
/// ENROLLED_ALWAYS = schedule-only (legacy default). ATTENDANCE_QUALIFIED = all-or-nothing flags.
enum BenefitEligibilityMode {
  ENROLLED_ALWAYS
  ATTENDANCE_QUALIFIED
}

model EmployeeBenefit {
  id             String      @id @default(cuid())
  organizationId String // Multi-tenancy support
  employee       Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String?
  benefitType    BenefitType @relation(fields: [benefitTypeId], references: [id], onDelete: Cascade)
  benefitTypeId  String
  payrollPeriod  PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String?

  // Legacy/basic metadata
  name        String?
  description String?

  // EPP-style benefit details
  totalAmount       Float
  currency          String @default("USD")
  totalInstallments Int    @default(6)
  installmentAmount Float
  remainingBalance  Float
  scheduleMode      BenefitScheduleMode?

  // RECURRING only: how often payroll ensures an installment (null = EVERY_CUTOFF)
  recurrenceFrequency BenefitRecurrenceFrequency?

  // Attendance-linked amount computation (optional; default fixed amount)
  attendanceBased       Boolean                        @default(false)
  attendanceAmountBasis BenefitAttendanceAmountBasis?

  // Attendance eligibility (optional; independent of amount pro-rate)
  eligibilityMode                    BenefitEligibilityMode @default(ENROLLED_ALWAYS)
  eligibilityDisqualifyOnAbsent      Boolean                @default(true)
  eligibilityDisqualifyOnLate        Boolean                @default(false)
  eligibilityDisqualifyOnUndertime   Boolean                @default(false)
  eligibilityDisqualifyOnLeave       Boolean                @default(false)

  // Legacy/simple details (kept for backward compatibility)
  amount    Float?
  attendanceBased Boolean @default(false)
  attendanceAmountBasis BenefitAttendanceAmountBasis?
  recurrenceFrequency BenefitRecurrenceFrequency?
  scheduleMode BenefitScheduleMode?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Payroll schedule
  startPayrollCutOff DateTime?
  endPayrollCutOff   DateTime?

  // Terms/agreement audit
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?
  agreedByIp    String?

  // Status and approval
  status       BenefitProgramStatus @default(PENDING)
  isActive     Boolean              @default(true)
  approvedById String?
  approvedAt   DateTime?
  notes        String?
  remarks      String?
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Relations
  installments EmployeeBenefitInstallment[]
  soaLineItems SOALineItem[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([benefitTypeId])
  @@index([payrollPeriodId])
  @@index([organizationId, status])
  @@index([organizationId, payrollPeriodId, isDeleted])
  @@index([employeeId, status])
  @@map("employee_benefits")
}

model EmployeeBenefitInstallment {
  id String @id @default(cuid())

  employeeBenefitId String
  employeeBenefit   EmployeeBenefit @relation(fields: [employeeBenefitId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount            Float
  scheduledDate     DateTime
  processedDate     DateTime?

  payrollCutOffId String?
  payrollRunId    String?

  status        BenefitDeductionStatus @default(SCHEDULED)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeBenefitId])
  @@index([scheduledDate])
  @@index([payrollCutOffId])
  @@map("employee_benefit_installments")
}
