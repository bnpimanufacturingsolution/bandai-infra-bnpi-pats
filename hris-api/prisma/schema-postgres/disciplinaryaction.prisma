// Disciplinary Action — HR case record for employee offenses/infractions.
// Spec gap M3.2: replaces the mock admin page with a real backend.

enum DisciplinaryActionStatus {
  OPEN
  ONGOING
  RESOLVED
  DISMISSED
}

model DisciplinaryAction {
  id             String @id @default(cuid())
  organizationId String

  employeeId String
  /// DENORMALIZED snapshot so lists survive employee edits (name at filing time)
  employeeName String?

  offenseType  String // TARDINESS | ABSENTeeism | MISCONDUCT | POLICY_VIOLATION | PERFORMANCE | OTHER
  offenseDate  DateTime @db.Date
  description  String
  severity     String @default("MEDIUM") // LOW | MEDIUM | HIGH
  status       DisciplinaryActionStatus @default(OPEN)

  actionTaken        String?
  resolutionNotes    String?
  resolvedAt         DateTime?
  attachmentDocumentId String?

  createdByUserId String?
  updatedByUserId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  metadata Json?

  @@index([organizationId, employeeId, isDeleted])
  @@index([organizationId, status, isDeleted])
  @@index([organizationId, offenseDate])
  @@map("disciplinary_actions")
}
