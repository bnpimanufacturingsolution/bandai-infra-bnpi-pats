// Dedicated onboarding checklist stack (builder + per-employee checklists + password sign-off).
// Intentionally separate from the generic BoardingProcess/ChecklistItem stack (offboarding unaffected).

enum OnboardingChecklistStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum OnboardingItemStatus {
  PENDING
  COMPLETED
}

model OnboardingTemplate {
  id String @id @default(cuid())

  organizationId String

  name        String
  description String?
  isActive    Boolean @default(true)

  sections OnboardingTemplateSection[]

  metadata Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isDeleted])
}

model OnboardingTemplateSection {
  id String @id @default(cuid())

  organizationId String

  templateId String
  template   OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title String
  order Int  @default(1)

  items OnboardingTemplateItem[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

model OnboardingTemplateItem {
  id String @id @default(cuid())

  organizationId String

  sectionId String
  section   OnboardingTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  parentId String?
  parent   OnboardingTemplateItem?  @relation("OnboardingTemplateItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children OnboardingTemplateItem[] @relation("OnboardingTemplateItemHierarchy")

  number  String  @default("")
  title   String
  description String?

  // Responsible department is OPTIONAL (parent rows typically have none).
  responsibleDepartmentId   String?
  responsibleDepartmentName String?

  order Int @default(1)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([parentId])
  @@index([responsibleDepartmentId])
}

model OnboardingChecklist {
  id String @id @default(cuid())

  organizationId String

  employeeId String
  employee   Employee @relation("EmployeeOnboardingChecklists", fields: [employeeId], references: [id], onDelete: Cascade)

  templateId String?

  title  String
  status OnboardingChecklistStatus @default(ACTIVE)

  startDate  DateTime  @default(now())
  targetDate DateTime?

  completionPercentage Int @default(0)

  sections OnboardingSection[]

  metadata Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([organizationId])
  @@index([isDeleted])
}

model OnboardingSection {
  id String @id @default(cuid())

  organizationId String

  checklistId String
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  title String
  order Int  @default(1)

  items OnboardingItem[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
}

model OnboardingItem {
  id String @id @default(cuid())

  organizationId String

  sectionId String
  section   OnboardingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  parentId String?
  parent   OnboardingItem?  @relation("OnboardingItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children OnboardingItem[] @relation("OnboardingItemHierarchy")

  number  String  @default("")
  title   String
  description String?

  // Responsible department is OPTIONAL (parent rows typically have none).
  responsibleDepartmentId   String?
  responsibleDepartmentName String?

  order Int @default(1)

  status        OnboardingItemStatus @default(PENDING)
  completedDate DateTime?
  // Server-stamped signature fields (never client-supplied).
  completedByEmployeeId String?
  signedByName          String?
  remarks               String?

  signatures OnboardingSignature[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([parentId])
  @@index([responsibleDepartmentId])
  @@index([status])
}

model OnboardingSignature {
  id String @id @default(cuid())

  organizationId String

  itemId String
  item   OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  signerEmployeeId     String
  signerName           String
  signerDepartmentId   String?
  signerDepartmentName String?

  method           String  @default("PASSWORD")
  passwordVerified Boolean @default(true)

  remarks String?

  signedAt DateTime @default(now())

  @@index([itemId])
  @@index([signerEmployeeId])
}
