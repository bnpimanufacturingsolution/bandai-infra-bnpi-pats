// Special Payroll — one-time compensation runs, fully separate from regular EmployeePayroll.
// Selected PayrollPeriod is display/context only; special runs never enter regular generation.

enum SpecialPayrollRunStatus {
  FINALIZED
  RELEASED
  CANCELLED
}

model SpecialPayrollRun {
  id             String @id @default(cuid())
  organizationId String

  /// Stable public identifier, e.g. SPR-20260729-A1B2C3
  runCode String
  /// Required operator label, e.g. "Annual Incentive 2026"
  label   String
  /// Product type remains Special Payroll (not a regular period code).
  runType String @default("SPECIAL_PAYROLL")

  status SpecialPayrollRunStatus @default(FINALIZED)

  /// Selected regular period used only for date labeling (optional FK).
  contextPayrollPeriodId String?
  contextPeriodCode      String?
  contextPeriodName      String?
  contextStartDate       DateTime @db.Date
  contextEndDate         DateTime @db.Date
  contextPayDate         DateTime @db.Date

  totalGross    Float @default(0)
  totalNet      Float @default(0)
  lineCount     Int   @default(0)
  employeeCount Int   @default(0)
  currency      String @default("PHP")

  sourceFilename    String?
  sourceHash        String?
  /// Fingerprint of normalized row set + context period (dedupe / audit).
  sourceFingerprint String
  idempotencyKey    String

  createdByUserId   String?
  releasedByUserId  String?
  cancelledByUserId String?
  cancelReason      String?

  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)

  metadata Json?

  lines    SpecialPayrollLine[]
  payslips SpecialPayrollPayslip[]

  @@unique([organizationId, runCode])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, isDeleted])
  @@index([organizationId, contextPayrollPeriodId, status, isDeleted])
  @@index([organizationId, sourceFingerprint])
  @@index([createdAt])
  @@map("special_payroll_runs")
}

model SpecialPayrollLine {
  id             String @id @default(cuid())
  organizationId String

  run   SpecialPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeId String

  /// Immutable snapshots at create time
  employeeNumber String
  employeeName   String

  benefitTypeId      String?
  compensationCode   String
  compensationName   String
  direction          String  @default("COMPENSATION")
  isTaxable          Boolean @default(false)

  /// Complete one-time payout; gross equals net in v1.
  amount Float

  sourceRowNumber Int?
  /// Audit-only source date from workbook START_PAY_DATE; does not schedule payout.
  sourcePayDate   DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([organizationId, employeeId])
  @@index([organizationId, compensationCode])
  @@index([runId, employeeId, compensationCode])
  @@map("special_payroll_lines")
}

model SpecialPayrollPayslip {
  id             String @id @default(cuid())
  organizationId String

  run   SpecialPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeId String

  employeeNumber String
  employeeName   String

  /// Stable payslip identifier, e.g. SPS-SPR-...-0001
  payslipNumber String

  grossPay Float
  netPay   Float

  /// Immutable compensation line snapshot for PDF/detail: [{code,name,amount,direction,isTaxable}]
  lineSnapshot Json

  isReleased Boolean   @default(false)
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, employeeId])
  @@unique([organizationId, payslipNumber])
  @@index([organizationId, employeeId, isReleased])
  @@index([runId])
  @@map("special_payroll_payslips")
}
