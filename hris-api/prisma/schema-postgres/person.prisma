enum GenderType {
  male
  female
  other
  prefer_not_to_say
  unknown
  not_applicable
}

enum PhoneType {
  mobile
  home
  work
  emergency
  fax
  pager
  main
  other
}

enum IdentificationType {
  passport
  drivers_license
  national_id
  postal_id
  voters_id
  senior_citizen_id
  company_id
  school_id
}

model Person {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String? // Reference to User in different microservice
  employeeId     String? // One-to-one: Single Employee ID that references this person
  personalInfo   Json?
  contactInfo    Json
  identification Json?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  // Relations
  employee   Employee?
  applicants Applicant[]
  children   Child[]
}

model Child {
  id             String      @id @default(cuid())
  organizationId String?
  parentId       String
  parent         Person      @relation(fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firstName      String
  middleName     String?
  lastName       String?
  dateOfBirth    DateTime
  gender         GenderType?
  notes          String?
  isDependent    Boolean?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  isDeleted      Boolean     @default(false)

  @@index([organizationId])
  @@index([parentId])
  @@index([organizationId, isDeleted, dateOfBirth])
}
