model BoardingTemplate {
  id String @id @default(cuid())

  organizationId String

  // Role-based boarding template (e.g., hris-employee, hris-hr-manager)
  // Only one template per role is allowed
  role String

  name        String
  description String?
  type        BoardingType
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)

  items TemplateItem[]

  metadata Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
