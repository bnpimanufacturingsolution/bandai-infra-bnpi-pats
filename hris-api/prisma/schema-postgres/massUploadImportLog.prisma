// Durable audit log for DM3 compensation / deduction mass uploads.
// Separate from MigrationRun so workbook run lifecycle stays clean.

model MassUploadImportLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// workbook | manpower-databank | compensation | deduction
  /// | dm1-workbook | dm2-workbook | dm4-workbook | dm4-overtime
  kind   String
  /// completed | partial | failed
  status String

  sourceFilename  String?
  /// Optional link to the DM3 MigrationRun the operator was viewing when uploading.
  migrationRunId  String?
  startedByUserId String?
  startedByUser   User?   @relation(fields: [startedByUserId], references: [id], onDelete: SetNull)

  total   Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  skipped Int @default(0)
  failed  Int @default(0)

  periodCodes      Json?
  summaryJson      Json
  errorsJson       Json
  resultsJson      Json?
  errorsTruncated  Boolean @default(false)
  resultsTruncated Boolean @default(false)

  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)

  @@index([organizationId, kind, createdAt])
  @@index([organizationId, migrationRunId])
  @@index([createdAt])
  @@map("mass_upload_import_logs")
}
