model DocumentFolder {
  id   String @id @default(cuid())
  name String

  employeeId String
  employee   Employee @relation("EmployeeDocumentFolders", fields: [employeeId], references: [id], onDelete: Cascade)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("documentFolders")
}
