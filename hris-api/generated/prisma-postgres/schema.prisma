enum RequestType {
  LEAVE
  TIMESHEET
  ATTENDANCE_CORRECTION
  EXPENSE_REIMBURSEMENT
  DOCUMENT_REQUEST
  RESIGNATION
  TERMINATION
  REGULARIZATION
  PROMOTION
  SALARY_CHANGE
  TRANSFER
  SCHEDULE_CHANGE
  OTHER
}

model Request {
  id             String  @id @default(cuid())
  organizationId String // Multi-tenancy support
  code           String? @unique // Human-readable request code (e.g., REQ-001)

  type                    RequestType
  currentWorkflowStateKey String      @default("OPEN")
  startDate               DateTime?
  endDate                 DateTime?
  description             String
  attachments             Json[]      @default([]) // Array of file URLs/paths (zdefaults to empty)

  requester   Employee @relation("RequestRequester", fields: [requesterId], references: [id])
  requesterId String

  targetEmployeeId String?
  targetEmployee   Employee? @relation("RequestTargetEmployee", fields: [targetEmployeeId], references: [id])

  // Workflow runtime
  workflowInstance   WorkflowInstance? @relation("RequestWorkflowInstance", fields: [workflowInstanceId], references: [id])
  workflowInstanceId String?

  // Workflow step executions (replaces departmentReviewers/employeeReviewers)
  stepExecutions WorkflowStepExecution[]
  transactions   RequestTransaction[]

  // Timesheet edit-permission targets using this request
  timesheetEditPermissionTargets Timesheet[] @relation("TimesheetEditPermissionRequest")
  createdJobs                    Job[]       @relation("JobSourceRequest")

  // Current step execution reference (many-to-one: multiple requests could theoretically point to same step, though unlikely)
  // This avoids the @unique requirement that causes issues with nullable fields
  currentStepExecution   WorkflowStepExecution? @relation("RequestCurrentWorkflowStep", fields: [currentStepExecutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentStepExecutionId String?

  // Last completed step execution reference (many-to-one)
  lastCompletedStepExecution   WorkflowStepExecution? @relation("RequestLastCompletedWorkflowStep", fields: [lastCompletedStepExecutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastCompletedStepExecutionId String?

  notes String?

  // Metadata structure:
  // {
  //   "employee_snapshot": {
  //     "id": "...",
  //     "employeeId": "EMP-001",
  //     "firstName": "John",
  //     "lastName": "Doe",
  //     "position": "Software Engineer",
  //     "department": "Engineering",
  //     "level": "Senior",
  //     "reportTo": { "id": "...", "name": "Jane Smith" }
  //   },
  //   "request_details": {
  //     // Request-type specific data
  //     // LEAVE: { leaveType, totalDays, etc. }
  //     // OVERTIME: { overtimeHours, reason, etc. }
  //     // PROMOTION: { newPosition, newLevel, effectiveDate, etc. }
  //   }
  // }
  metadata Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([requesterId])
  @@index([currentWorkflowStateKey])
  @@index([workflowInstanceId])
  @@index([organizationId, requesterId, type, isDeleted, createdAt])
  @@map("requests")
}

enum RequestTransactionEventCategory {
  LIFECYCLE
  WORKFLOW
  ASSIGNMENT
  BUSINESS_CHANGE
  ARTIFACT
  SYSTEM
}

enum RequestTransactionEventKey {
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_CANCELLED
  WORKFLOW_STATE_CHANGED
  STEP_ASSIGNED
  STEP_APPROVED
  STEP_REJECTED
  STEP_COMPLETED
  STEP_SKIPPED
  STEP_DELEGATED
  DOCUMENT_GENERATED
}

enum RequestTransactionActorType {
  EMPLOYEE
  MANAGER
  HR
  SYSTEM
  UNKNOWN
}

enum RequestTransactionVisibility {
  SHARED
  INTERNAL
}

model RequestTransaction {
  id                 String  @id @default(cuid())
  organizationId     String
  requestId          String
  workflowInstanceId String?
  stepExecutionId    String?
  actorEmployeeId    String?

  request          Request                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance?      @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stepExecution    WorkflowStepExecution? @relation(fields: [stepExecutionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actorEmployee    Employee?              @relation("RequestTransactionActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  sequenceNumber    Int
  eventCategory     RequestTransactionEventCategory
  eventKey          RequestTransactionEventKey
  eventSource       String?
  actorType         RequestTransactionActorType     @default(UNKNOWN)
  actorRole         String?
  actorDisplayName  String?
  title             String
  description       String?
  comments          String?
  fromStateKey      String?
  toStateKey        String?
  fieldChanges      Json?
  metadata          Json?
  visibility        RequestTransactionVisibility    @default(SHARED)
  isSystemGenerated Boolean                         @default(false)
  occurredAt        DateTime                        @default(now())
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  @@unique([requestId, sequenceNumber])
  @@index([organizationId, requestId, occurredAt])
  @@index([workflowInstanceId])
  @@index([stepExecutionId])
  @@index([actorEmployeeId])
  @@index([requestId, eventCategory, occurredAt])
  @@map("request_transactions")
}

