model Employee {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String

  userId                    String?
  role                      String
  // Employment Details
  employmentHireDate        DateTime?
  employmentStartDate       DateTime? // Actual start date when employee began working
  employmentTerminationDate DateTime?
  employmentStatus          EmploymentStatus @default(ACTIVE)
  employmentType            EmploymentType   @default(PROBATIONARY)
  workforceSource           WorkforceSource  @default(DIRECT)
  agencyId                  String?
  agency                    Agency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employer                  Json?

  probationEndDate DateTime?

  // Position & Department
  department   Department @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId String

  position   Position @relation(fields: [positionId], references: [id])
  positionId String

  // Level
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  levelId String?

  // Reporting Structure
  reportTo      Employee?  @relation("EmployeeReportsTo", fields: [reportToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportToId    String?
  directReports Employee[] @relation("EmployeeReportsTo") //employees that reports to this employee

  workLocation             WorkLocation @default(ONSITE)
  // Leave Balances (stored as embedded array)
  leaveBalances            Json
  leaveBalancesLastUpdated DateTime?

  // Compensation
  basicSalary  Float
  /// Register Daily Salary (Path A OT: hourly = dailyRate/8). Null/0 → Path B BNPI 313.
  dailyRate    Float?
  currency     String       @default("PHP")
  payFrequency PayFrequency @default(SEMI_MONTHLY)

  deviceEmpId String?

  // Soft delete & timestamps
  isTour           Boolean  @default(false)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isManager        Boolean  @default(false)
  /// true when role === "hris-hr-manager" (derived from dept + level, never both isManager + isHrManager)
  isHrManager      Boolean  @default(false)
  embeddedSchedule Json?
  metadata         Json?

  // Relations
  person   Person? @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personId String  @unique

  device   Device? @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deviceId String?

  attendances                        Attendance[]
  attendanceObligations              AttendanceObligation[]
  appliedAttendanceCorrections       Attendance[]                 @relation("AttendanceAppliedBy")
  timesheets                         Timesheet[]
  timesheetlines                     Timesheetline[]
  timesheetEditPermissionsGranted    Timesheet[]                  @relation("TimesheetEditPermissionGrantedBy")
  timesheetEditPermissionsRejected   Timesheet[]                  @relation("TimesheetEditPermissionRejectedBy")
  requests                           Request[]                    @relation("RequestRequester") // Requests this employee submitted
  eligibilityRequests                Request[]                    @relation("RequestTargetEmployee") // Requests where this employee is the subject
  stepExecutions                     WorkflowStepExecution[] // Workflow steps assigned to this employee
  requestTransactions                RequestTransaction[]         @relation("RequestTransactionActor")
  scheduleOverrides                  ScheduleOverride[]           @relation("EmployeeScheduleOverrides")
  scheduleOverridesCreated           ScheduleOverride[]           @relation("ScheduleOverridesCreatedBy")
  departmentScheduleTemplatesCreated DepartmentScheduleTemplate[] @relation("DepartmentScheduleTemplatesCreatedBy")

  employeePayrolls             EmployeePayroll[]
  employeeBenefits             EmployeeBenefit[]
  employeeLoans                EmployeeLoan[]
  // documents          EmployeeDocument[]
  documents                    Document[]            @relation("EmployeeDocuments") // Employee's documents stored in separate collection for better querying and file management
  employmentHistory            Json
  managedDepartments           Department[]          @relation("DepartmentManager")
  documentFolders              DocumentFolder[]      @relation("EmployeeDocumentFolders")
  convertedApplicants          Applicant[]           @relation("ApplicantConvertedEmployee") // Applicants converted into this employee record
  recruitmentActivities        RecruitmentActivity[] @relation("RecruitmentActivityActor")
  uploadedApplicantAttachments ApplicantAttachment[] @relation("ApplicantAttachmentUploader")

  calendarItem CalendarItem[]

  boardingProcesses             BoardingProcess[]         @relation("EmployeeBoardingProcesses")
  notificationsCreated          Notification[]            @relation("NotificationSource") // Notifications sourced/created by this employee
  activityLogs                  ActivityLogging[]
  auditLogs                     AuditLogging[]
  scheduleHistoryRecords        EmployeeScheduleHistory[] @relation("EmployeeScheduleHistoryTarget")
  scheduleHistoryRecordsCreated EmployeeScheduleHistory[] @relation("EmployeeScheduleHistoryActor")

  // Termination relations
  terminationsAsEmployee   Termination[] @relation("EmployeeTerminations") // Terminations where this employee is the terminated one
  terminationsInitiated    Termination[] @relation("TerminationInitiator") // Terminations this employee initiated
  terminationsAsHRDirector Termination[] @relation("HRDirectorApprovals") // Terminations this employee approved as HR Director
  terminationsAsLegal      Termination[] @relation("LegalApprovals") // Terminations this employee approved as Legal

  soaLineItems SOALineItem[]

  soasReconciled StatementOfAccount[] @relation("SOAReconciledBy")

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@index([userId]) // safe for nulls
  @@index([role])
  @@index([levelId]) // safe for nulls
  @@index([reportToId]) // fast lookup for employees reporting to a manager
  @@index([departmentId, levelId]) // B-tree compound index for hierarchy queries (dept â†’ level traversal)
  @@index([organizationId, departmentId]) // Optimized org+dept lookup for migration & reporting
  @@index([organizationId, workforceSource])
  @@index([organizationId, workforceSource, payFrequency, isDeleted])
  @@index([organizationId, isDeleted, employmentStatus, payFrequency, updatedAt])
  @@index([organizationId, agencyId])
  @@index([organizationId, employeeId, isDeleted])
  @@map("employees")
}

enum BenefitProgramStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  DEFAULTED
}

enum BenefitDeductionStatus {
  SCHEDULED
