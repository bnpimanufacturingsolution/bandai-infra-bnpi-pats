model EmployeeBenefit {
  id             String      @id @default(cuid())
  organizationId String // Multi-tenancy support
  employee       Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String?
  benefitType    BenefitType @relation(fields: [benefitTypeId], references: [id], onDelete: Cascade)
  benefitTypeId  String

  // Legacy/basic metadata
  name        String?
  description String?

  // EPP-style benefit details
  totalAmount       Float
  currency          String @default("USD")
  totalInstallments Int    @default(6)
  installmentAmount Float
  remainingBalance  Float

  // Legacy/simple details (kept for backward compatibility)
  amount    Float?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Payroll schedule
  startPayrollCutOff DateTime?
  endPayrollCutOff   DateTime?

  // Terms/agreement audit
  agreedToTerms Boolean   @default(false)
  agreedAt      DateTime?
  agreedByIp    String?

