enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentReviewSource {
  EMPLOYEE_UPLOAD
  HR_UPLOAD
  MIGRATION
  SYSTEM
}

enum DocumentReviewEventType {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  SUPERSEDED
  SYSTEM_SYNCED
}

model Document {
  id                    String                @id @default(cuid())
  name                  String
  type                  String // Document type (e.g., passport, driver_license, sss_id, etc.)
  number                String // Document number/identifier
  issueDate             DateTime // Date when document was issued
  expiryDate            DateTime? // Expiry date (optional, for documents that expire)
  fileUrl               String? // URL to uploaded file (PDF/image)
  ext                   String?
  documentTypeId        String?
  fieldValues           Json?
  reviewStatus          DocumentReviewStatus?
  reviewSubmittedAt     DateTime?
  reviewSubmittedById   String?
  reviewApprovedAt      DateTime?
  reviewApprovedById    String?
  reviewRejectedAt      DateTime?
  reviewRejectedById    String?
  reviewRejectionReason String?
  reviewSource          DocumentReviewSource?
  metadata              Json?

  employeeId   String // Reference to the employee this document belongs to
  employee     Employee              @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Employee associated with this document
  documentType DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewEvents DocumentReviewEvent[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([number])
  @@index([documentTypeId])
  @@index([employeeId, reviewStatus])
  @@index([documentTypeId, reviewStatus])
  @@map("documents")
}

model DocumentReviewEvent {
  id              String                  @id @default(cuid())
  organizationId  String
  documentId      String
  document        Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employeeId      String
  actorEmployeeId String?
  eventType       DocumentReviewEventType
  fromStatus      DocumentReviewStatus?
  toStatus        DocumentReviewStatus?
  reason          String?
  comments        String?
  source          DocumentReviewSource
  fileUrl         String?
  fieldChanges    Json?
  occurredAt      DateTime                @default(now())
  createdAt       DateTime                @default(now())

  @@index([organizationId, employeeId, occurredAt])
  @@index([documentId, occurredAt])
  @@index([actorEmployeeId])
  @@map("document_review_events")
}

model DocumentFolder {
  id   String @id @default(cuid())
  name String

  employeeId String
  employee   Employee @relation("EmployeeDocumentFolders", fields: [employeeId], references: [id], onDelete: Cascade)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("documentFolders")
}

model DocumentType {
  id                String   @id @default(cuid())
  organizationId    String
  code              String
  name              String
  category          String?
  uploadBy          String   @default("HR")
  isRequired        Boolean  @default(false)
  isEmployeeVisible Boolean  @default(true)
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  fields            Json
  metadata          Json?
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
