  status       BenefitProgramStatus @default(PENDING)
  isActive     Boolean              @default(true)
  approvedById String?
  approvedAt   DateTime?
  notes        String?
  remarks      String?
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

