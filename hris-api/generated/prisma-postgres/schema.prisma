model SOALineItem {
  id                   String             @id @default(cuid())
  statementOfAccount   StatementOfAccount @relation(fields: [statementOfAccountId], references: [id], onDelete: Cascade)
  statementOfAccountId String

  category    String? // Remittance category (e.g., "TAX", "SSS", "LOAN", "BENEFIT")
  description String?

  // Employee relation
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId String?

  // Source references
  employeePayroll   EmployeePayroll? @relation(fields: [employeePayrollId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeePayrollId String?
  employeeLoan      EmployeeLoan?    @relation(fields: [employeeLoanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeLoanId    String?
  employeeBenefit   EmployeeBenefit? @relation(fields: [employeeBenefitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeBenefitId String?

  // Amounts
  taxableAmount Float @default(0) // Base amount used for tax calculation
  taxAmount     Float @default(0) // Tax amount represented by this line item
  employeeShare Float @default(0)
  employerShare Float @default(0)
  totalAmount   Float @default(0) // employee + employer

  metadata Json? // {
  //   employeeName: "Dela Cruz, Juan",
  //   employeeNumber: "EMP-001",
  //   externalReferenceNumber: "SSS-1234567890",
  //   loanBalance: 45000,
  //   installmentNumber: 3,
  //   contributionBase: 25000,
  //   rate: 0.05
  // }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statementOfAccountId])
  @@index([employeeId])
  @@index([employeePayrollId])
  @@index([employeeLoanId])
  @@index([employeeBenefitId])
  @@map("soa_line_items")
}

enum RemittanceStatus {
  PENDING
  PROCESSING
  REMITTED
  CONFIRMED
  FAILED
  REVERSED
}

model SOARemittance {
  id                   String             @id @default(cuid())
  statementOfAccount   StatementOfAccount @relation(fields: [statementOfAccountId], references: [id], onDelete: Cascade)
  statementOfAccountId String

  // Payment details
  amount          Float
  paymentMethod   String? // BANK_TRANSFER, CHECK, ONLINE_PAYMENT, CASH, GCash
  referenceNumber String? // Bank reference / check number / transaction ID
  paymentDate     DateTime @db.Date

  // Recipient / category
  category String? // Which category this payment covers (e.g., "TAX", "SSS", "LOAN")

  // Status
  status RemittanceStatus @default(PENDING)

  notes    String?
  metadata Json? // {
  //   remitteeName: "SSS",
  //   remitteeAccount: "SSS-001-2345",
  //   confirmedAt: "2026-01-20T00:00:00Z",
  //   confirmedBy: "<employeeId>",
  //   eppTransactionId: "EPP-TXN-123",
  //   receiptUrl: "https://...",
  //   receiptName: "sss-receipt-jan2026.pdf",
  //   bankName: "BDO",
  //   governmentReceiptNumber: "..."
  // }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statementOfAccountId])
  @@index([status])
  @@index([paymentDate])
  @@map("soa_remittances")
}

enum SOAStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PARTIALLY_REMITTED
  REMITTED
  RECONCILED
  DISPUTED
  CLOSED
}

model StatementOfAccount {
  id             String @id @default(cuid())
  organizationId String // Multi-tenancy support
  soaNumber      String // Auto-generated (e.g., "SOA-202601-001")
  name           String // e.g., "January 2026 1st Half - EPP Loan Remittance"

  // Configurable period (independent of PayrollPeriod, differs per client)
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  dueDate   DateTime? @db.Date // When remittance is due to external party

  // Payroll period linkage (SOA may cover one or more payroll periods)
  payrollPeriodIds String[]

  // Summary totals
  totalEmployeeShare Float @default(0)
  totalEmployerShare Float @default(0)
  totalTax           Float @default(0) // Flattened from SOA line item tax amounts
  totalAmount        Float @default(0) // Grand total (employee + employer)
  totalRemitted      Float @default(0)
  totalOutstanding   Float @default(0) // totalAmount - totalRemitted

  // EPP integration / reconciliation
  eppReferenceId    String?
  eppBillingId      String?
  eppReconciled     Boolean   @default(false)
  eppReconciledAt   DateTime?
  eppReconciledBy   Employee? @relation("SOAReconciledBy", fields: [eppReconciledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eppReconciledById String?

  // Remittee / recipient info (SSS, BIR, PhilHealth, Pag-IBIG, loan provider)
  remitteeName    String?
  remitteeAccount String?
  remitteeDetails Json?

  // Status & workflow
  status SOAStatus @default(DRAFT)

  notes       String?
  description String?
  metadata    Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lineItems   SOALineItem[]
  remittances SOARemittance[]

  @@unique([organizationId, soaNumber])
  @@index([organizationId])
  @@index([organizationId, startDate, endDate])
  @@index([status])
  @@index([startDate, endDate])
  @@index([dueDate])
  @@map("statements_of_account")
}

