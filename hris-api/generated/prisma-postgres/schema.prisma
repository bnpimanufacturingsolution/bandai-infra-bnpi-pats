model PayrollPeriod {
  id             String        @id @default(cuid())
  organizationId String // Multi-tenancy support
  name           String // e.g., "January 2025 - 1st Half"
  code           String? // Auto-generated code based on startDate and endDate (e.g., "PP-20260101-20260115")
