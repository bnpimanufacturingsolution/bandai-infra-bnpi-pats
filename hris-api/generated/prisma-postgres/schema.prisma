// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma-postgres"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("PG_DATABASE_URL")
}

model ActivityLogging {
  id             String    @id @default(cuid())
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  headers        Json?
  ip             String
  path           String
  method         String
  page           Json?
  action         String
  description    String
  payload        Json? // Request/Response payload (can contain {entry: {...}, exit: {...}})
  organizationId String?
  entityType     String?
  archive        Json?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum WorkforceSource {
  DIRECT
  AGENCY
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
}

model Agency {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  status         AgencyStatus @default(ACTIVE)
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  metadata       Json?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("agencies")
}

enum ApplicationSource {
  WEBSITE
  REFERRAL
  JOB_BOARD
  SOCIAL_MEDIA
  RECRUITER
  INTERNAL
  WALK_IN
  OTHER
}

enum RecruitmentActivityType {
  NOTE
  INTERVIEW
  REJECTION
  OFFER
  ASSIGNMENT
  EMAIL_EVENT
  SYSTEM_EVENT
}

enum ApplicantAttachmentType {
  RESUME
  CONTRACT
  PORTFOLIO
  CERTIFICATE
  OTHER
}

model Applicant {
  id             String  @id @default(cuid())
  organizationId String
  applicantId    String? // Optional unique identifier for the applicant

  // Personal Information (can reference Person or store directly)
  personId     String? // Optional reference to Person model
  person       Person? @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  portfolioUrl String?

  // Application Details
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Application Information
  appliedDate                  DateTime           @default(now())
  applicationSource            ApplicationSource?
  workflowInstanceId           String?
  currentWorkflowStateKey      String             @default("APPLIED")
  currentStepExecutionId       String?
  lastCompletedStepExecutionId String?

  // Expected Salary & Availability
  expectedSalary   Float?
  currency         String?   @default("PHP")
  availabilityDate DateTime? // When can they start
  noticePeriod     Int? // Days of notice period in current job
  metadata         Json?

  // Referral Information
  referredBy    String? // Employee ID who referred this applicant
  referralBonus Float?

  // Soft delete & timestamps
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  // Can add relation to Employee if they get hired (converted from applicant to employee)
  convertedToEmployeeId      String? // Reference to Employee ID if hired
  convertedToEmployee        Employee?               @relation("ApplicantConvertedEmployee", fields: [convertedToEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workflowInstance           WorkflowInstance?       @relation("ApplicantWorkflowInstance", fields: [workflowInstanceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentStepExecution       WorkflowStepExecution?  @relation("ApplicantCurrentWorkflowStep", fields: [currentStepExecutionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lastCompletedStepExecution WorkflowStepExecution?  @relation("ApplicantLastCompletedWorkflowStep", fields: [lastCompletedStepExecutionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stepExecutions             WorkflowStepExecution[] @relation("ApplicantWorkflowStepExecutions")
  activities                 RecruitmentActivity[]
  attachments                ApplicantAttachment[]

  @@index([organizationId])
  @@index([applicantId]) // Index for applicantId if provided
  @@index([positionId])
  @@index([jobId])
  @@index([departmentId])
  @@index([appliedDate])
  @@index([personId])
  @@index([workflowInstanceId])
  @@index([currentWorkflowStateKey])
  @@index([currentStepExecutionId])
  @@index([lastCompletedStepExecutionId])
  @@index([convertedToEmployeeId])
  @@map("applicants")
}

model RecruitmentActivity {
  id                 String                  @id @default(cuid())
  organizationId     String
  applicantId        String
  workflowInstanceId String?
  stepExecutionId    String?
  stateKey           String?
  type               RecruitmentActivityType
  title              String
  details            Json?
  actorEmployeeId    String?
  occurredAt         DateTime                @default(now())
  isDeleted          Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  applicant        Applicant              @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflowInstance WorkflowInstance?      @relation("RecruitmentActivityWorkflowInstance", fields: [workflowInstanceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stepExecution    WorkflowStepExecution? @relation("RecruitmentActivityStepExecution", fields: [stepExecutionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actorEmployee    Employee?              @relation("RecruitmentActivityActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organizationId, applicantId, occurredAt])
  @@index([workflowInstanceId])
  @@index([stepExecutionId])
  @@index([actorEmployeeId])
  @@map("recruitment_activities")
}

model ApplicantAttachment {
  id                   String                  @id @default(cuid())
  organizationId       String
  applicantId          String
  type                 ApplicantAttachmentType
  name                 String
  url                  String
  mimeType             String?
  size                 Int?
  uploadedByEmployeeId String?
  uploadedAt           DateTime                @default(now())
  isDeleted            Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  applicant          Applicant @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedByEmployee Employee? @relation("ApplicantAttachmentUploader", fields: [uploadedByEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organizationId, applicantId, uploadedAt])
  @@index([uploadedByEmployeeId])
  @@map("applicant_attachments")
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  INCOMPLETE
  ABSENT
  REST_DAY
}

enum AttendanceLedgerType {
  RAW
  CORRECTION
}

model Attendance {
  id                String           @id @default(cuid())
  organizationId    String // Multi-tenancy support
  employee          Employee         @relation(fields: [employeeId], references: [id])
  employeeId        String
  appliedByEmployee Employee?        @relation("AttendanceAppliedBy", fields: [appliedBy], references: [id])
  date              DateTime?        @default(now())
  timeIn            DateTime?        @default(now())
  timeBreak         DateTime?
  timeOut           DateTime?
  status            AttendanceStatus @default(PRESENT)
  behaviorFlags     String[]         @default([])

  // Resolved schedule snapshot for this attendance date.
  // Captures override/template source and effective shift fields.
  scheduleSnapshot Json?

  // Geolocation data
  timeInLocation  Json? // {lat: number, lng: number, address: string}
  timeOutLocation Json? // {lat: number, lng: number, address: string}

  // Biometric/Device info
  deviceInfo             Json? // Device details for mobile check-in
  isManualEntry          Boolean              @default(false)
  approvedBy             String?
  ledgerType             AttendanceLedgerType @default(RAW)
  sourceRequestId        String?
  supersedesAttendanceId String?
  appliedAt              DateTime?
  appliedBy              String?
  isEffective            Boolean              @default(true)

  // Timekeeping calculations (auto-calculated from timeIn, timeOut, and schedule)
  // Minute precision (for calculations)
  totalMinutesWorked Int? // Total minutes worked (timeOut - timeIn - breaks)
  regularMinutes     Int? // Regular minutes within schedule
  overtimeMinutes    Int? // Minutes exceeding schedule
  undertimeMinutes   Int? // Minutes short of schedule
  lateMinutes        Int? // Minutes late for clock-in after grace deduction
  earlyOutMinutes    Int? // Minutes early for clock-out
  breakMinutes       Int? // Total break time in minutes

  // Lightweight employee snapshots for aggregate filtering/search
  employeeCodeSnapshot    String?
  employeeNameSnapshot    String?
  departmentIdSnapshot    String?
  departmentNameSnapshot  String?
  reportToIdSnapshot      String?
  workforceSourceSnapshot WorkforceSource?
  agencyIdSnapshot        String?

  // Formatted hours (for display) - e.g. "8:30"
  hoursWorked    String?
  regularHours   String?
  overtimeHours  String?
  undertimeHours String?
  lateHours      String?
  earlyOutHours  String?

  // Timesheet reference - links this attendance to a timesheet
  timesheet             Timesheet?             @relation(fields: [timesheetId], references: [id])
  timesheetId           String?
  timesheetlines        Timesheetline[]
  attendanceObligations AttendanceObligation[]

  notes     String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([timesheetId])
  @@index([organizationId, employeeId, date])
  @@index([organizationId, employeeId, date, isEffective])
  @@index([organizationId, employeeId, sourceRequestId])
  @@index([organizationId, isDeleted, isEffective, date])
  @@index([organizationId, isDeleted, isEffective, date, status])
  @@index([organizationId, isDeleted, isEffective, date, employeeId])
  @@index([organizationId, isDeleted, isEffective, date, departmentIdSnapshot])
  @@index([organizationId, isDeleted, isEffective, date, reportToIdSnapshot])
  @@map("attendances")
}

model AttendanceObligation {
  id String @id @default(cuid())

  organizationId  String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeId      String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String

  date         DateTime @db.Date
  businessDate String
  timezone     String   @default("Asia/Manila")
  status       String   @default("EXPECTED")
  phase        String   @default("PLANNED")

  attendance      Attendance?    @relation(fields: [attendanceId], references: [id])
  attendanceId    String?
  timesheet       Timesheet?     @relation(fields: [timesheetId], references: [id])
  timesheetId     String?
  timesheetline   Timesheetline? @relation(fields: [timesheetlineId], references: [id])
  timesheetlineId String?

  expectedStartAt DateTime?
  expectedEndAt   DateTime?
  timeIn          DateTime?
  timeBreak       DateTime?
  timeOut         DateTime?

  hoursWorked    String?
  regularHours   String?
  overtimeHours  String?
  undertimeHours String?
  lateHours      String?
  earlyOutHours  String?
  breakMinutes   Int?

  behaviorFlags       String[] @default([])
  scheduleSnapshot    Json?
  scheduleFingerprint String?
  source              String
  sourceRequestId     String?
  metadata            Json?

  employeeCodeSnapshot    String?
  employeeNameSnapshot    String?
  departmentIdSnapshot    String?
  departmentNameSnapshot  String?
  reportToIdSnapshot      String?
  workforceSourceSnapshot WorkforceSource?
  agencyIdSnapshot        String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeId, payrollPeriodId, date])
  @@index([organizationId, payrollPeriodId, status, isDeleted])
  @@index([organizationId, date, status, isDeleted])
  @@index([organizationId, employeeId, date, isDeleted])
  @@index([organizationId, departmentIdSnapshot, date, isDeleted])
  @@index([organizationId, reportToIdSnapshot, date, isDeleted])
  @@index([attendanceId])
  @@index([timesheetId])
  @@index([timesheetlineId])
  @@map("attendance_obligations")
}

model AuditLogging {
  id            String    @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  type          String
  severity      String
  entity        Json
  changes       Json?
  metadata      Json?
  description   String?
  payload       Json? // Request/Response payload (can contain {entry: {...}, exit: {...}})
  archiveStatus Boolean   @default(false)
  archiveDate   DateTime?
  isDeleted     Boolean   @default(false)
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum BenefitCategory {
  INSURANCE
  ALLOWANCE
  BONUS
  RETIREMENT
  HEALTH
  EDUCATION
  TRANSPORTATION
  OTHER
}

model BenefitType {
  id             String          @id @default(cuid())
  organizationId String // Multi-tenancy support
  name           String
  description    String?
  category       BenefitCategory @default(OTHER)

  provider String?
  coverage Float?

  // Value settings
  minAmount   Float?
  maxAmount   Float?
  fixedAmount Float?
  percentage  Float? // Percentage of basic salary

  // Eligibility
  minServiceMonths Int? // Minimum months of service required

  // Tax treatment
  isTaxable Boolean @default(false)

  // Program defaults (EPP-style benefits)
  defaultInstallments   Int     @default(6)
  payrollCycleDays      Int     @default(15)
  requireTermsAgreement Boolean @default(true)

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employeeBenefits EmployeeBenefit[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("benefit_types")
}

model BoardingProcess {
  id String @id @default(cuid())

  organizationId String

  employeeId String
  employee   Employee @relation("EmployeeBoardingProcesses", fields: [employeeId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  type   BoardingType
  status BoardingStatus @default(NOT_STARTED)

  startDate          DateTime  @default(now())
  targetDate         DateTime // Complete date for onboarding, last working day for offboarding
  actualCompleteDate DateTime?

  exitReason String? // For offboarding only

  assignedToId   String?
  assignedToName String?

  checklistItems ChecklistItem[]
  notes          Note[]

  metadata Json? // Flexible field for additional data

  lastViewedAt         DateTime?
  reminderFrequency    String? // DAILY, WEEKLY, etc.
  completionPercentage Int       @default(0) // Cache this for performance

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BoardingType {
  ONBOARDING
  OFFBOARDING
}

enum BoardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model BoardingTemplate {
  id String @id @default(cuid())

  organizationId String

  // Role-based boarding template (e.g., hris-employee, hris-hr-manager)
  // Only one template per role is allowed
  role String

  name        String
  description String?
  type        BoardingType
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)

  items TemplateItem[]

  metadata Json?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CalculatorType {
  BASIC
  GROSS_TO_NET
  NET_TO_GROSS
  THIRTEENTH_MONTH
  CUSTOM
}

model Calculator {
  id             String         @id @default(cuid())
  organizationId String // Multi-tenancy support
  code           String? // Unique code for calculator (e.g., CALC-DEFAULT-2026)
  name           String
  description    String?
  type           CalculatorType @default(BASIC)

  // Tax and contribution settings
  // Configured based on TRAIN Law patterns (see tax-calculator.helper.ts)
  taxRates Json? // [
  //   {
  //     annualBase: 0,
  //     annualCap: 250000,
  //     annualFixedTax: 0,
  //     monthlyBase: 0,
  //     monthlyCap: 20833,
  //     monthlyFixedTax: 0,
  //     rate: 0
  //   },
  //   {
  //     annualBase: 250000,
  //     annualCap: 400000,
  //     annualFixedTax: 0,
  //     monthlyBase: 20833,
  //     monthlyCap: 33332,
  //     monthlyFixedTax: 0,
  //     rate: 0.15
  //   },
  //   {
  //     annualBase: 400000,
  //     annualCap: 800000,
  //     annualFixedTax: 22500,
  //     monthlyBase: 33333,
  //     monthlyCap: 66666,
  //     monthlyFixedTax: 1875,
  //     rate: 0.2
  //   },
  //   {
  //     annualBase: 800000,
  //     annualCap: 2000000,
  //     annualFixedTax: 102500,
  //     monthlyBase: 66667,
  //     monthlyCap: 166666,
  //     monthlyFixedTax: 8542,
  //     rate: 0.25
  //   },
  //   {
  //     annualBase: 2000000,
  //     annualCap: 8000000,
  //     annualFixedTax: 402500,
  //     monthlyBase: 166667,
  //     monthlyCap: 666666,
  //     monthlyFixedTax: 33542,
  //     rate: 0.3
  //   },
  //   {
  //     annualBase: 8000000,
  //     annualCap: null,
  //     annualFixedTax: 2202500,
  //     monthlyBase: 666667,
  //     monthlyCap: null,
  //     monthlyFixedTax: 183542,
  //     rate: 0.35
  //   }
  // ]

  // SSS Contribution Configuration
  sssRates Json? // {
  //   employeeRate: 0.05,  // 5%
  //   employerRate: 0.1, // 10%
  //   totalRate: 0.15,    // 15%
  //   minimumBase: 250,
  //   maximumCeiling: 1750,
  // }

  // PhilHealth Contribution Configuration
  philHealthRates Json? // {
  //   employeeRate: 0.025, // 2.5%
  //   employerRate: 0.025, // 2.5%
  //   totalRate: 0.05,     // 5%
  //   minimumBase: 250,
  //   maximumCeiling: 2500, // Ceiling for now
  // }

  // PAG-IBIG Contribution Configuration
  pagibigRates Json? // {
  //   rateBelowThreshold: 0.01, // 1% for monthly income 1500 and below
  //   rateAboveThreshold: 0.02, // 2% for monthly income above 1500
  //   threshold: 1500,
  //   maximumCeiling: 200,      // Max contribution (100 employee + 100 employer)
  // }

  // Rate Multipliers for all pay types based on DOLE standards
  // Organized by scenario with work, OT, ND (night diff), and NDOT rates
  rateMultipliers Json? // {
  //   ordinaryDay: {
  //     work: 1.000,  // Work (1st 8h) - 100%
  //     ot: 1.250,    // OT (>8h) - 125%
  //     nd: 1.100,    // ND (10pm-6am) - 110%
  //     ndot: 1.375   // NDOT - 137.5%
  //   },
  //   restDayOrSpecialHoliday: {
  //     work: 1.300,  // 130%
  //     ot: 1.690,    // 169%
  //     nd: 1.430,    // 143%
  //     ndot: 1.859   // 185.9%
  //   },
  //   specialHolidayOnRestDay: {
  //     work: 1.500,  // 150%
  //     ot: 1.950,    // 195%
  //     nd: 1.650,    // 165%
  //     ndot: 2.145   // 214.5%
  //   },
  //   regularHoliday: {
  //     work: 2.000,  // 200%
  //     ot: 2.600,    // 260%
  //     nd: 2.200,    // 220%
  //     ndot: 2.860   // 286%
  //   },
  //   regularHolidayOnRestDay: {
  //     work: 2.600,  // 260%
  //     ot: 3.380,    // 338%
  //     nd: 2.860,    // 286%
  //     ndot: 3.718   // 371.8%
  //   },
  //   doubleHoliday: {
  //     work: 3.000,  // 300%
  //     ot: 3.900,    // 390%
  //     nd: 3.300,    // 330%
  //     ndot: 4.290   // 429%
  //   },
  //   doubleHolidayOnRestDay: {
  //     work: 3.900,  // 390%
  //     ot: 5.070,    // 507%
  //     nd: 4.290,    // 429%
  //     ndot: 5.577   // 557.7%
  //   }
  // }

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payrollPeriods PayrollPeriod[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("calculators")
}

enum CalendarItemType {
  HOLIDAY // Holidays visible to all users
  EVENT // Events that can be assigned to specific users
  COMPANY_EVENT // Company-wide events
  MEETING // Regular meetings
  DEADLINE // Task deadlines
  REMINDER // Personal reminders
  BIRTHDAY // Emplyoee Birthday
}

enum ItemStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  DRAFT
}

model CalendarItem {
  id String @id @default(cuid())

  organizationId String
  year           Int? // Year for grouping calendar items
  title          String
  description    String?

  type CalendarItemType

  startDate DateTime
  endDate   DateTime
  isAllDay  Boolean  @default(false)
  timezone  String   @default("UTC")

  recurrence Json?

  metadata Json?

  reminders Json?

  tags String[]

  status ItemStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  assignedEmployeeId String?

  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@index([tags])
  @@index([status])
  @@index([organizationId])
  @@index([year])
  @@index([organizationId, year])
  @@map("calendar_items")
}

model ChecklistItem {
  id             String          @id @default(cuid())
  organizationId String
  processId      String
  process        BoardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  category        ChecklistCategory
  status          ChecklistStatus   @default(PENDING)
  priority        Priority          @default(MEDIUM)
  dueDate         DateTime
  completedDate   DateTime?
  completedBy     String?
  completedByName String?
  order           Int

  uiElement String? // CSS selector for tour

  comments String?
  metadata Json? // Flexible field for custom data

  // Add these helpful fields:
  isOptional    Boolean  @default(false)
  estimatedTime Int? // Minutes to complete
  dependencies  String[] // IDs of tasks that must be completed first

  // Tracking
  viewedAt     DateTime?
  startedAt    DateTime? // When user clicked "Start"
  reminderSent DateTime?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChecklistCategory {
  HR_DOCUMENTATION
  IT_SETUP
  WORKSPACE_SETUP
  TRAINING
  COMPLIANCE
  ACCESS_MANAGEMENT
  EQUIPMENT
  BENEFITS
  KNOWLEDGE_TRANSFER
  EXIT_INTERVIEW
  ORIENTATION
  SECURITY
  PAYROLL
  OTHER
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  FOR_REVIEW
  COMPLETED
  SKIPPED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?

  // Manager: Optional, one-to-one
  managerId String?
  manager   Employee? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentHierarchy")

  isHr Boolean @default(false) // Flag to indicate if this department is HR (for special handling in workflows)

  boardings BoardingProcess[]
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  isDeleted Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  positions                    Position[]
  employees                    Employee[]
  scheduleTemplates            DepartmentScheduleTemplate[] @relation("DepartmentScheduleTemplates")
  applicants                   Applicant[]
  workforceRecruitmentPolicies WorkforceRecruitmentPolicy[]
  jobs                         Job[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model DepartmentScheduleTemplate {
  id                  String                           @id @default(cuid())
  organizationId      String
  departmentId        String
  scheduleTemplateId  String
  source              DepartmentScheduleTemplateSource @default(department_head_linked)
  createdByEmployeeId String?
  isActive            Boolean                          @default(true)
  isDeleted           Boolean                          @default(false)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  department        Department       @relation("DepartmentScheduleTemplates", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleTemplate  ScheduleTemplate @relation(fields: [scheduleTemplateId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  createdByEmployee Employee?        @relation("DepartmentScheduleTemplatesCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([departmentId, scheduleTemplateId], map: "department_schedule_template_unique")
  @@index([organizationId, departmentId, isDeleted])
  @@index([organizationId, scheduleTemplateId, isDeleted])
  @@index([createdByEmployeeId])
  @@map("department_schedule_templates")
