enum TerminationType {
  PERFORMANCE
  MISCONDUCT
  REDUNDANCY
  END_OF_CONTRACT
  FAILED_PROBATION
}

enum TerminationStatus {
  DRAFT
  PENDING_HR_DIRECTOR
  PENDING_LEGAL
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

model Termination {
  id                String @id @default(cuid())
  terminationNumber String @unique // Auto: TRM-2025-0001
  organizationId    String

  // Employee being terminated
  employee   Employee @relation("EmployeeTerminations", fields: [employeeId], references: [id])
  employeeId String

  // Who initiated the termination (HR/Manager)
  initiatedBy   Employee @relation("TerminationInitiator", fields: [initiatedById], references: [id])
  initiatedById String

  // Termination details
  terminationType  TerminationType
  status           TerminationStatus @default(DRAFT)
  terminationDate  DateTime
  lastWorkingDay   DateTime
  reason           String
  severancePackage String?

  // Supporting documents (warning letters, performance reviews, etc.)
  supportingDocuments Json[] @default([])

  // HR Director approval
  hrDirectorApprovedAt DateTime?
  hrDirectorApprovedBy Employee? @relation("HRDirectorApprovals", fields: [hrDirectorId], references: [id])
  hrDirectorId         String?
  hrDirectorComments   String?

  // Legal review (optional, for certain termination types)
  legalApprovalRequired Boolean   @default(false)
  legalApprovedAt       DateTime?
  legalApprovedBy       Employee? @relation("LegalApprovals", fields: [legalApproverId], references: [id])
  legalApproverId       String?
  legalComments         String?

  // Processing tracking
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  // Final payroll and clearance
  finalPayCalculated    Boolean @default(false)
  clearanceCompleted    Boolean @default(false)
  terminationLetterPath String?

  // Soft delete & timestamps
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit logs
  auditLogs TerminationAuditLog[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([initiatedById])
  @@map("terminations")
}

model TerminationAuditLog {
  id            String      @id @default(cuid())
  termination   Termination @relation(fields: [terminationId], references: [id], onDelete: Cascade)
  terminationId String

  action          String // CREATED, SUBMITTED, HR_APPROVED, LEGAL_APPROVED, REJECTED, COMPLETED, etc.
  performedBy     String
  performedByName String
  fromStatus      String?
  toStatus        String?
  comments        String?
  metadata        Json?
  timestamp       DateTime @default(now())

  @@index([terminationId])
  @@map("termination_audit_logs")
}

// Timesheet Model
// Allows employees to submit timesheets based on their attendance records

enum TimesheetStatus {
  DRAFT // Being prepared by employee
  SUBMITTED // Submitted for approval
  APPROVED // Approved by manager/HR
  REJECTED // Rejected by approver
  REVISED // Returned for revision
}

enum TimesheetEditPermissionStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
  REVOKED
}

enum TimesheetRejectBehavior {
  REVISE
  REJECT
}

// Timesheet Configuration Model
// Organization-level settings for timesheet behavior
model TimesheetConfig {
  id             String @id @default(cuid())
  organizationId String @unique // One config per organization

  // Auto-approval settings
  enableAutoApprove Boolean @default(false)

  // Employee editing permissions
  enableEditBeforeSubmission Boolean @default(true)

  // Behavior when manager rejects submission review
  rejectBehavior TimesheetRejectBehavior @default(REVISE)

  // Minimum schedule-based overtime minutes required to set OVERTIME behavior flag
  overtimeFlagThresholdMinutes Int @default(60)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timesheet_configs")
}

model Timesheet {
  id             String   @id @default(cuid())
  code           String   @unique // Unique timesheet identifier (auto-generated: YYYYMMDDTTTTTTTTTTT - date + timestamp)
  organizationId String // Multi-tenancy support
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String

  // Payroll period link (enables central period management)
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String

  // Attendance relation - attendances included in this timesheet
  attendances Attendance[]

  // Payroll relation - link to generated payroll (optional one-to-one)
  employeePayroll EmployeePayroll?

  // Materialized day-level source of truth for attendance reporting
  timesheetlines        Timesheetline[]
  attendanceObligations AttendanceObligation[]

  // Summary fields (auto-calculated from attendance records)
  totalDays           Int?
  totalHoursWorked    String? // Formatted as "HH:MM" (e.g., "80:16")
  totalRegularHours   String? // Formatted as "HH:MM"
  totalOvertimeHours  String? // Formatted as "HH:MM"
  totalUndertimeHours String? // Formatted as "HH:MM"
  totalLateHours      String? // Formatted as "HH:MM"
  totalEarlyOutHours  String? // Formatted as "HH:MM"
  metadata            Json? // Stores minute values: totalMinutesWorked, totalRegularMinutes, etc.

  // Workflow status
  status TimesheetStatus @default(DRAFT)

  // Submission tracking
  submittedAt     DateTime?
  submittedBy     String?
  approvedBy      String?
  approvalDate    DateTime?
  rejectionReason String?

  // Optional fields
  notes String?

  // Edit-permission workflow state
  editPermissionStatus             TimesheetEditPermissionStatus @default(NONE)
  editPermissionRequestId          String?
  editPermissionRequest            Request?                      @relation("TimesheetEditPermissionRequest", fields: [editPermissionRequestId], references: [id])
  editPermissionRequestedAt        DateTime?
  editPermissionGrantedAt          DateTime?
  editPermissionGrantedBy          String?
  editPermissionGrantedByEmployee  Employee?                     @relation("TimesheetEditPermissionGrantedBy", fields: [editPermissionGrantedBy], references: [id])
  editPermissionRejectedAt         DateTime?
  editPermissionRejectedBy         String?
  editPermissionRejectedByEmployee Employee?                     @relation("TimesheetEditPermissionRejectedBy", fields: [editPermissionRejectedBy], references: [id])
  editPermissionRejectionReason    String?
  editPermissionConsumedAt         DateTime?
  editPermissionExpiresAt          DateTime?
  editPermissionReason             String?

  // Metadata
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Note: code field is unique via @unique attribute above - ensures each timesheet has unique code

  // Unique constraints
  @@unique([organizationId, employeeId, payrollPeriodId], name: "unique_timesheet_per_period") // One timesheet per employee per payroll period
  // Indexes for query optimization
  @@index([organizationId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@index([status])
  @@index([editPermissionStatus])
  @@index([editPermissionRequestId])
  @@index([isDeleted]) // Index for filtering soft-deleted records
  @@index([organizationId, employeeId, isDeleted]) // Composite index for employee timesheets query
  @@index([organizationId, payrollPeriodId, status, isDeleted])
  @@index([organizationId, employeeId, payrollPeriodId, editPermissionStatus])
  @@index([organizationId, employeeId, payrollPeriodId, isDeleted])
  @@map("timesheets")
}

model Timesheetline {
  id String @id @default(cuid())

  organizationId  String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeId      String
  timesheet       Timesheet     @relation(fields: [timesheetId], references: [id])
  timesheetId     String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String
  attendance      Attendance?   @relation(fields: [attendanceId], references: [id])
  attendanceId    String?

  date DateTime @db.Date

  timeIn        DateTime?
  timeBreak     DateTime?
  timeOut       DateTime?
  status        String    @default("NOT_CLOCKED_IN")
  behaviorFlags String[]  @default([])

  scheduleSnapshot Json?
  hoursWorked      String?
  regularHours     String?
  overtimeHours    String?
  undertimeHours   String?
  lateHours        String?
  earlyOutHours    String?
  breakMinutes     Int?

  employeeNotes String?
  approverNotes String?
  notes         String?
  metadata      Json?
  primaryMarker String?
  isManualEntry Boolean @default(false)
  isVirtual     Boolean @default(false)

  revisionNo       Int       @default(1)
  isEffective      Boolean   @default(true)
  ledgerType       String    @default("SNAPSHOT")
  supersedesLineId String?
  supersededById   String?
  supersededAt     DateTime?
  editedAt         DateTime?
  editedBy         String?
  editReason       String?

  employeeCodeSnapshot    String?
  employeeNameSnapshot    String?
  departmentIdSnapshot    String?
  departmentNameSnapshot  String?
  reportToIdSnapshot      String?
  workforceSourceSnapshot WorkforceSource?
  agencyIdSnapshot        String?
  attendanceObligations   AttendanceObligation[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, timesheetId, date, revisionNo])
  @@index([organizationId, date, isDeleted])
  @@index([organizationId, payrollPeriodId, date, isDeleted])
  @@index([organizationId, employeeId, date, isDeleted])
  @@index([organizationId, timesheetId, date, isEffective])
  @@index([organizationId, employeeId, date, isEffective])
  @@index([organizationId, status, date, isDeleted])
  @@index([organizationId, departmentIdSnapshot, date, isDeleted])
  @@index([organizationId, reportToIdSnapshot, date, isDeleted])
  @@index([timesheetId])
  @@index([attendanceId])
  @@index([supersedesLineId])
  @@index([supersededById])
  @@map("timesheet_lines")
}

enum UserStatus {
  active
  inactive
  suspended
  archived
}

model User {
  id          String     @id @default(cuid())
  userName    String?    @unique
  email       String     @unique
  password    String?
  role        String
  status      UserStatus @default(active)
  isDeleted   Boolean    @default(false)
  lastLogin   DateTime?
  loginMethod String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metadata Json?

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@map("users")
}

enum WorkflowDomain {
  REQUEST
  RECRUITMENT
  PAYROLL
}

enum WorkflowStepType {
  SUBMISSION
  APPROVAL
  TASK
}

enum WorkflowAssigneeType {
  REQUESTER
  SUPERVISOR
  TARGET_DEPARTMENT_MANAGER
  HR
  SYSTEM
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
  SKIPPED
}

model WorkflowInstance {
  id             String @id @default(cuid())
  organizationId String

  domain         WorkflowDomain
  domainRecordId String?
  requestType    RequestType?

  code        String?
  name        String?
  description String?

  steps  Json
  states Json?

  currentStateKey String   @default("OPEN")
  stateHistory    Json[]   @default([])
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests              Request[]               @relation("RequestWorkflowInstance")
  applicants            Applicant[]             @relation("ApplicantWorkflowInstance")
  stepExecutions        WorkflowStepExecution[]
  requestTransactions   RequestTransaction[]
  recruitmentActivities RecruitmentActivity[]   @relation("RecruitmentActivityWorkflowInstance")

  @@index([organizationId, domain, isDeleted])
  @@index([organizationId, domain, requestType, isDeleted])
  @@index([domain, domainRecordId])
  @@map("workflow_instances")
}

model WorkflowStepExecution {
  id             String @id @default(cuid())
  organizationId String

  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflowInstanceId String

  request     Request?   @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestId   String?
  applicant   Applicant? @relation("ApplicantWorkflowStepExecutions", fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicantId String?

  requestsAsCurrent         Request[]             @relation("RequestCurrentWorkflowStep")
  requestsAsLastCompleted   Request[]             @relation("RequestLastCompletedWorkflowStep")
  requestTransactions       RequestTransaction[]
  applicantsAsCurrent       Applicant[]           @relation("ApplicantCurrentWorkflowStep")
  applicantsAsLastCompleted Applicant[]           @relation("ApplicantLastCompletedWorkflowStep")
  recruitmentActivities     RecruitmentActivity[] @relation("RecruitmentActivityStepExecution")

  stepNumber Int
  stepName   String
  stepType   WorkflowStepType

  assigneeType WorkflowAssigneeType
  assigneeRole String?

  assignee   Employee? @relation(fields: [assigneeId], references: [id])
  assigneeId String?

  status      WorkflowStepStatus @default(PENDING)
  completedAt DateTime?
  comments    String?
  metadata    Json?

  isRequired Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workflowInstanceId])
  @@index([requestId])
  @@index([applicantId])
  @@index([assigneeId])
  @@index([status])
  @@index([organizationId])
  @@index([workflowInstanceId, isDeleted, status, stepNumber])
  @@index([requestId, isDeleted, status, stepNumber])
  @@index([applicantId, isDeleted, status, stepNumber])
  @@map("workflow_step_executions")
}

enum WorkforceRecruitmentLimitBehavior {
  WARN
  BLOCK
}

model WorkforceRecruitmentSetting {
  id             String @id @default(cuid())
  organizationId String

  isEnabled                     Boolean   @default(true)
  enforceDepartmentManagerScope Boolean   @default(true)
  defaultWorkflowCode           String    @default("WF-REQUEST-HIRING-REQUISITION-DEFAULT")
  requestSubtype                String    @default("DEPARTMENT_JOB_REQUISITION")
  autoCreateJobOnApproval       Boolean   @default(true)
  seededAt                      DateTime?

  policies  WorkforceRecruitmentPolicy[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([organizationId])
  @@map("workforce_recruitment_settings")
}

model WorkforceRecruitmentPolicy {
  id String @id @default(cuid())

  settingId      String
  organizationId String
  departmentId   String?
  positionId     String?
  levelId        String?

  targetHeadcount Int                               @default(0)
  limitBehavior   WorkforceRecruitmentLimitBehavior @default(WARN)

  defaultWorkflowCode     String?
  autoCreateJobOnApproval Boolean  @default(true)
  jobType                 String?
  jobLocation             String?
  jobTags                 String[]
  jobDescriptionTemplate  String?
  isActive                Boolean  @default(true)

  setting    WorkforceRecruitmentSetting @relation(fields: [settingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  position   Position?                   @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  level      Level?                      @relation(fields: [levelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([settingId])
  @@index([organizationId])
  @@index([organizationId, departmentId, positionId, levelId, isActive])
  @@map("workforce_recruitment_policies")
}
