{
	"info": {
		"_postman_id": "exit-clearance-flow-test",
		"name": "Exit Clearance Flow - Happy Path",
		"description": "Complete happy path test for Exit Clearance feature in HRIS. This collection tests:\n1. Create Offboarding Template\n2. Create Resignation Request\n3. Manager Approve Resignation\n4. HR Approve Resignation\n5. Start Exit Clearance (creates BoardingProcess with checklist)\n6. Complete Checklist Items\n7. Generate COE Document",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "organizationId",
			"value": "YOUR_ORG_ID_HERE",
			"type": "string"
		},
		{
			"key": "employeeId",
			"value": "YOUR_EMPLOYEE_ID_HERE",
			"type": "string"
		},
		{
			"key": "managerId",
			"value": "YOUR_MANAGER_ID_HERE",
			"type": "string"
		},
		{
			"key": "hrManagerId",
			"value": "YOUR_HR_MANAGER_ID_HERE",
			"type": "string"
		},
		{
			"key": "departmentId",
			"value": "YOUR_DEPARTMENT_ID_HERE",
			"type": "string"
		},
		{
			"key": "offboardingTemplateId",
			"value": "",
			"type": "string"
		},
		{
			"key": "resignationRequestId",
			"value": "",
			"type": "string"
		},
		{
			"key": "boardingProcessId",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{authToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. Create Offboarding Template",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.id) {",
							"    pm.collectionVariables.set('offboardingTemplateId', jsonData.data.id);",
							"    console.log('Template ID saved:', jsonData.data.id);",
							"}",
							"pm.test('Template created successfully', function() {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"organizationId\": \"{{organizationId}}\",\n    \"name\": \"Resignation Exit Clearance Template\",\n    \"description\": \"Default offboarding checklist for resignations\",\n    \"type\": \"OFFBOARDING\",\n    \"role\": \"hris-employee-resignation\",\n    \"departmentId\": \"{{departmentId}}\",\n    \"items\": [\n        {\n            \"title\": \"Knowledge Transfer Documentation\",\n            \"description\": \"Complete knowledge transfer documents for all ongoing projects\",\n            \"category\": \"KNOWLEDGE_TRANSFER\",\n            \"priority\": \"HIGH\",\n            \"order\": 1,\n            \"dueOffset\": 7\n        },\n        {\n            \"title\": \"Project Handover\",\n            \"description\": \"Hand over all active projects to designated colleagues\",\n            \"category\": \"KNOWLEDGE_TRANSFER\",\n            \"priority\": \"HIGH\",\n            \"order\": 2,\n            \"dueOffset\": 10\n        },\n        {\n            \"title\": \"Exit Interview\",\n            \"description\": \"Schedule and complete exit interview with HR\",\n            \"category\": \"EXIT_INTERVIEW\",\n            \"priority\": \"MEDIUM\",\n            \"order\": 3,\n            \"dueOffset\": 5\n        },\n        {\n            \"title\": \"Return Company Equipment\",\n            \"description\": \"Return laptop, ID badge, keys, and other company property\",\n            \"category\": \"HR_DOCUMENTATION\",\n            \"priority\": \"HIGH\",\n            \"order\": 4,\n            \"dueOffset\": 3\n        },\n        {\n            \"title\": \"IT Access Revocation\",\n            \"description\": \"Coordinate with IT for system access removal\",\n            \"category\": \"HR_DOCUMENTATION\",\n            \"priority\": \"HIGH\",\n            \"order\": 5,\n            \"dueOffset\": 1\n        },\n        {\n            \"title\": \"Final Pay Computation\",\n            \"description\": \"Complete final pay calculation including prorated salary and benefits\",\n            \"category\": \"PAYROLL\",\n            \"priority\": \"HIGH\",\n            \"order\": 6,\n            \"dueOffset\": 14\n        },\n        {\n            \"title\": \"COE Request Processing\",\n            \"description\": \"Process Certificate of Employment request\",\n            \"category\": \"HR_DOCUMENTATION\",\n            \"priority\": \"MEDIUM\",\n            \"order\": 7,\n            \"dueOffset\": 14\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/boarding-template",
					"host": ["{{baseUrl}}"],
					"path": ["api", "boarding-template"]
				}
			}
		},
		{
			"name": "2. Create Resignation Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.id) {",
							"    pm.collectionVariables.set('resignationRequestId', jsonData.data.id);",
							"    console.log('Request ID saved:', jsonData.data.id);",
							"}",
							"pm.test('Resignation request created successfully', function() {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"organizationId\": \"{{organizationId}}\",\n    \"requesterId\": \"{{employeeId}}\",\n    \"type\": \"RESIGNATION\",\n    \"status\": \"PENDING\",\n    \"description\": \"Voluntary resignation for personal reasons\",\n    \"startDate\": \"2026-02-01T00:00:00.000Z\",\n    \"endDate\": \"2026-02-28T00:00:00.000Z\",\n    \"metadata\": {\n        \"reasonCategory\": \"Personal\",\n        \"reasonDetails\": \"Relocating to another city for family reasons\",\n        \"lastWorkingDay\": \"2026-02-28\",\n        \"noticePeriodDays\": 30\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/request",
					"host": ["{{baseUrl}}"],
					"path": ["api", "request"]
				}
			}
		},
		{
			"name": "3. Manager Approve Resignation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Manager approval successful', function() {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.request.status).to.be.oneOf(['APPROVED', 'PROCESSING']);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"action\": \"approve\",\n    \"status\": \"PROCESSING\",\n    \"comment\": \"Approved by manager. Proceeding to HR review.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/request/{{resignationRequestId}}/approval",
					"host": ["{{baseUrl}}"],
					"path": ["api", "request", "{{resignationRequestId}}", "approval"]
				}
			}
		},
		{
			"name": "4. HR Approve Resignation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('HR approval successful', function() {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.request.status).to.equal('APPROVED');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"action\": \"approve\",\n    \"status\": \"APPROVED\",\n    \"comment\": \"HR approved. Ready for exit clearance process.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/request/{{resignationRequestId}}/approval",
					"host": ["{{baseUrl}}"],
					"path": ["api", "request", "{{resignationRequestId}}", "approval"]
				}
			}
		},
		{
			"name": "5. Start Exit Clearance (Offboarding)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Exit clearance started successfully', function() {",
							"    pm.response.to.have.status(201);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.boardingProcess).to.exist;",
							"    pm.expect(jsonData.data.boardingProcess.type).to.equal('OFFBOARDING');",
							"    pm.expect(jsonData.data.request.status).to.equal('OFFBOARDING_IN_PROGRESS');",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.boardingProcess) {",
							"    pm.collectionVariables.set('boardingProcessId', jsonData.data.boardingProcess.id);",
							"    console.log('BoardingProcess ID saved:', jsonData.data.boardingProcess.id);",
							"    console.log('Checklist items created:', jsonData.data.boardingProcess.checklistItems?.length || 0);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"boardingTemplateId\": \"{{offboardingTemplateId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/request/{{resignationRequestId}}/start-offboarding",
					"host": ["{{baseUrl}}"],
					"path": ["api", "request", "{{resignationRequestId}}", "start-offboarding"]
				}
			}
		},
		{
			"name": "6. Get Boarding Process with Checklist",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Boarding process retrieved with checklist items', function() {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.type).to.equal('OFFBOARDING');",
							"    pm.expect(jsonData.data.checklistItems).to.be.an('array');",
							"    console.log('Total checklist items:', jsonData.data.checklistItems?.length);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}/api/boarding-process/{{boardingProcessId}}?fields=id,type,status,completionPercentage,exitReason,checklistItems(id,title,category,status,dueDate)",
					"host": ["{{baseUrl}}"],
					"path": ["api", "boarding-process", "{{boardingProcessId}}"],
					"query": [
						{
							"key": "fields",
							"value": "id,type,status,completionPercentage,exitReason,checklistItems(id,title,category,status,dueDate)"
						}
					]
				}
			}
		},
		{
			"name": "7. Update Checklist Item (Complete)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Checklist item updated successfully', function() {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status\": \"COMPLETED\",\n    \"completedAt\": \"2026-02-15T10:00:00.000Z\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/checklist-item/CHECKLIST_ITEM_ID_HERE",
					"host": ["{{baseUrl}}"],
					"path": ["api", "checklist-item", "CHECKLIST_ITEM_ID_HERE"]
				},
				"description": "Replace CHECKLIST_ITEM_ID_HERE with actual checklist item ID from step 6"
			}
		},
		{
			"name": "8. Generate COE Document",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('COE generated successfully', function() {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.documentUrl).to.exist;",
							"    console.log('Document URL:', jsonData.data.documentUrl);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"COE\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/request/{{resignationRequestId}}/generate-document",
					"host": ["{{baseUrl}}"],
					"path": ["api", "request", "{{resignationRequestId}}", "generate-document"]
				}
			}
		}
	]
}
