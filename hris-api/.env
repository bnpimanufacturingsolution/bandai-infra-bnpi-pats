HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Source of truth for local host tools: deployed appliance Postgres reached
# either directly on the running VM LAN IP or through Cloudflare Access TCP.
#
# npm run dev now auto-resolves the active DB target in this order:
#   1. the configured host if it is reachable
#   2. another known Project Truth VM LAN IP if one is reachable
#   3. a localhost Cloudflare DB forward for the same environment
#
# Manual fallback from the repo root:
#   .\scripts\project-truth.ps1 start-bnpi-db-access -Environment dev
#
# Hostname mapping:
#   PROD db.bnpi-hris.tech      -> 127.0.0.1:55432 -> VM port 15432
#   DEV  dev-db.bnpi-hris.tech  -> 127.0.0.1:55433 -> VM port 15433
#   UAT  uat-db.bnpi-hris.tech  -> 127.0.0.1:55434 -> VM port 15434
#
# Default local npm run dev now targets the canonical VM DEV database on the
# direct LAN path first. If this workstation cannot route to the VM, predev can
# still fall back to a localhost Cloudflare DB forward for the same environment.

PG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55435/hris?schema=public
WRITE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55435/hris?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55435/hris?schema=public

PROJECT_TRUTH_PROD_PG_DATABASE_URL=postgresql://postgres:postgres@10.184.37.19:15432/hris?schema=public
PROJECT_TRUTH_DEV_PG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55435/hris?schema=public
PROJECT_TRUTH_UAT_PG_DATABASE_URL=postgresql://postgres:postgres@10.184.37.19:15434/hris?schema=public

POSTGRES_DB=hris
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=55433
HRIS_SKIP_LOCAL_DB_BOOTSTRAP=true

IDP_ENABLED=false
AUTH_BASE_URL=http://localhost:3001
AUTH_SUPERADMIN_EMAIL=super@admin.com
AUTH_SUPERADMIN_PASSWORD=password123
MIGRATION_DEFAULT_PASSWORD=Password123!

JWT_SECRET=local-dev-jwt-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_CREDENTIALS=true

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

SEED_PROVISION_CONCURRENCY=2
SEED_ARTIFACT_CONCURRENCY=1
SEED_ATTENDANCE_DAY_BATCH_SIZE=5
SEED_TX_MAX_WAIT_MS=30000
SEED_TX_TIMEOUT_MS=120000



INTEGRATION_API_KEYS=hris_xrbiaq75yffwvi7hiijpy88okqs88vxa00zkyg1atwdu9sqi


LMS_EXTERNAL_HANDOFF_SECRET="dev-external-handoff-secret-local-only"
LMS_ACCESS_TOKEN_SECRET="s@mple"
ACCESS_TOKEN_SECRET="s@mple"
JWT_SECRET="s@mple"
EXTERNAL_HANDOFF_SECRET="s@mple"

LMS_API_URL=http://localhost:5000

EPMR_APP_URL=http://localhost:5181
LMS_APP_URL=http://localhost:5173

