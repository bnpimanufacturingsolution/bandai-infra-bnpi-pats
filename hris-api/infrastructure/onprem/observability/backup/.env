# Backup scheduler and retention controls
BACKUP_INTERVAL_SECONDS=3600
# Tighter defaults after root-full incident (was 48/30; rolling alone reached ~161G).
BACKUP_KEEP_ROLLING=24
BACKUP_KEEP_FULL=7
FULL_FREQUENCY=daily

# Optional: override backup output dir inside container
# BACKUP_ROOT=/backups

# Remote replication (off-machine)
REMOTE_REPLICATION_ENABLED=false
REPLICATION_INTERVAL_SECONDS=1800
# Example remote path values:
#   s3-remote:hris-observability-backups
#   sftp-remote:/srv/backups/hris-observability
RCLONE_REMOTE_PATH=
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8
RCLONE_LOG_LEVEL=INFO
