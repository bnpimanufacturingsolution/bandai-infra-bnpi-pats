# Copy this file to rclone.conf and fill with your real credentials.
# Mount path used by compose: ./rclone/rclone.conf

# Example S3 remote
[s3-remote]
type = s3
provider = AWS
env_auth = false
access_key_id = CHANGE_ME
secret_access_key = CHANGE_ME
region = ap-southeast-1

# Example SFTP remote
[sftp-remote]
type = sftp
host = CHANGE_ME
user = CHANGE_ME
port = 22
key_file = /config/rclone/id_ed25519
# or password-based:
# pass = CHANGE_ME_OBSCURED
