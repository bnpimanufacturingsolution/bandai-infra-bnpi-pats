{
  "uid": "hris-container-logs",
  "title": "HRIS Container Logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["hris", "logs", "loki"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({stack=~\"hris-observability|hris-k3s\"}, container)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Live Container Logs",
      "datasource": "Loki",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "{stack=~\"hris-observability|hris-k3s\", container=~\"$container\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ]
}
