{
    "uid":  "hris-user-activity-audit",
    "title":  "HRIS User Activity and Audit",
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  11,
    "refresh":  "10s",
    "tags":  [
                 "hris",
                 "activity",
                 "audit",
                 "security",
                 "onprem"
             ],
    "description":  "Production-grade HRIS user activity, audit trail, and security monitoring dashboard. Shows parsed user context, top active users, module distribution, trace links to Tempo, and filters for authenticated users only.",
    "time":  {
                 "from":  "now-7d",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "current":  {
                                                        "text":  "prod",
                                                        "value":  "prod"
                                                    },
                                        "name":  "environment",
                                        "query":  "label_values({service=~\"hris-api.*\"}, environment)",
                                        "type":  "query",
                                        "datasource":  {
                                                           "type":  "loki",
                                                           "uid":  "loki"
                                                       }
                                    },
                                    {
                                        "current":  {
                                                        "text":  "All",
                                                        "value":  ""
                                                    },
                                        "name":  "module",
                                        "query":  "label_values({service=~\"hris-api.*\", environment=~\"$environment\"}, module)",
                                        "type":  "query",
                                        "datasource":  {
                                                           "type":  "loki",
                                                           "uid":  "loki"
                                                       }
                                    },
                                    {
                                        "current":  {
                                                        "text":  "All",
                                                        "value":  ""
                                                    },
                                        "name":  "user_name",
                                        "query":  "label_values({service=~\"hris-api.*\", environment=~\"$environment\"}, user_name)",
                                        "type":  "query",
                                        "datasource":  {
                                                           "type":  "loki",
                                                           "uid":  "loki"
                                                       }
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "row",
                       "title":  "Overview \u0026 Activity",
                       "collapsed":  false,
                       "gridPos":  {
                                       "h":  1,
                                       "w":  24,
                                       "x":  0,
                                       "y":  0
                                   }
                   },
                   {
                       "id":  10,
                       "type":  "barchart",
                       "title":  "Top Active Users (Requests, Selected Period)",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  1
                                   },
                       "targets":  [
                                       {
                                           "expr":  "topk(10, sum by (full_name, user_name) (count_over_time({service=~\"hris-api.*\", environment=~\"$environment\"} |= \"api.activity.request\" | json | authenticated=\"true\" [$__range])))",
                                           "legendFormat":  "{{full_name}} ({{user_name}})",
                                           "queryType":  "instant",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "color":  {
                                                                          "mode":  "palette-classic"
                                                                      },
                                                            "decimals":  0,
                                                            "min":  0,
                                                            "unit":  "none"
                                                        }
                                       },
                       "options":  {
                                       "orientation":  "horizontal",
                                       "showValue":  "always",
                                       "stacking":  "none",
                                       "groupWidth":  0.7,
                                       "barWidth":  0.85,
                                       "legend":  {
                                                      "displayMode":  "list",
                                                      "placement":  "bottom",
                                                      "showLegend":  true
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single",
                                                       "sort":  "desc"
                                                   },
                                       "xTickLabelRotation":  0,
                                       "xTickLabelSpacing":  100
                                   }
                   },
                   {
                       "id":  11,
                       "type":  "piechart",
                       "title":  "Activity by Module",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  1
                                   },
                       "targets":  [
                                       {
                                           "expr":  "sum by (module) (count_over_time({service=~\"hris-api.*\", environment=~\"$environment\"} |= \"api.activity.request\" | json | authenticated=\"true\" [$__range]))",
                                           "legendFormat":  "{{module}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "pieType":  "pie",
                                       "legend":  {
                                                      "displayMode":  "table",
                                                      "placement":  "right",
                                                      "values":  [
                                                                     "percent",
                                                                     "value"
                                                                 ]
                                                  }
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "color":  {
                                                                          "mode":  "fixed",
                                                                          "fixedColor":  "#E60012"
                                                                      }
                                                        }
                                       }
                   },
                   {
                       "id":  3,
                       "type":  "logs",
                       "title":  "User Activity Logs (Authenticated Only)",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  12,
                                       "w":  24,
                                       "x":  0,
                                       "y":  10
                                   },
                       "targets":  [
                                       {
                                           "expr":  "{service=~\"hris-api.*\", environment=~\"$environment\"} |= \"api.activity.request\" | json | authenticated=\"true\" | line_format \"{{.full_name}} ({{if .user_name}}{{.user_name}}{{else}}{{.user_id}}{{end}}) - {{.method}} {{.route}} [{{.status_code}}]{{if .action_type}} action={{.action_type}}{{end}}{{if .entity_id}} entity_id={{.entity_id}}{{end}}{{if .request_payload_summary}} payload={{.request_payload_summary}}{{end}}\"",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showTime":  true,
                                       "showLabels":  true,
                                       "showCommonLabels":  false,
                                       "wrapLogMessage":  true,
                                       "prettifyJSON":  true,
                                       "enableLogDetails":  true
                                   },
                       "fieldConfig":  {
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "trace_id"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "links",
                                                                                        "value":  [
                                                                                                      {
                                                                                                          "title":  "View Trace in Tempo",
                                                                                                          "url":  "http://localhost:3200/explore?schema=tempo\u0026query=${__value.raw}"
                                                                                                      }
                                                                                                  ]
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       }
                   },
                   {
                       "id":  4,
                       "type":  "logs",
                       "title":  "Failed / Unauthorized / High Privilege Actions",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  10,
                                       "w":  24,
                                       "x":  0,
                                       "y":  22
                                   },
                       "targets":  [
                                       {
                                           "expr":  "{service=~\"hris-api.*\", environment=~\"$environment\"} |= \"api.activity.request\" |~ \"status_code\\\":(4|5)|401|403|DELETE|PUT|POST.*(employee|payroll|admin)\" | json",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showTime":  true,
                                       "showLabels":  true,
                                       "wrapLogMessage":  true,
                                       "prettifyJSON":  true
                                   }
                   },
                   {
                       "id":  12,
                       "type":  "heatmap",
                       "title":  "Activity Heatmap (by Hour of Day)",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  10,
                                       "w":  24,
                                       "x":  0,
                                       "y":  32
                                   },
                       "targets":  [
                                       {
                                           "expr":  "sum(count_over_time({service=~\"hris-api.*\", environment=~\"$environment\"} |= \"api.activity.request\" | json | authenticated=\"true\" [1h]))",
                                           "legendFormat":  "authenticated activity",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "calculate":  true,
                                       "cellSize":  "small",
                                       "yAxis":  {
                                                     "axisPlacement":  "left"
                                                 }
                                   }
                   },
                   {
                       "id":  2,
                       "type":  "timeseries",
                       "title":  "API Error Rate (4xx/5xx)",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  42
                                   },
                       "targets":  [
                                       {
                                           "expr":  "sum by (route) (rate(hris_api_http_requests_total{status_code=~\"4..|5..\"}[5m]))",
                                           "legendFormat":  "{{route}}",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  13,
                       "type":  "stat",
                       "title":  "Failed Login Attempts (Last 24h)",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  24,
                                       "x":  0,
                                       "y":  51
                                   },
                       "targets":  [
                                       {
                                           "expr":  "sum(count_over_time({service=~\"hris-api.*\", environment=~\"$environment\"} |= \"login\" |~ \"401|403|failed|auth.token.invalid|auth.token.missing\" [24h]))",
                                           "queryType":  "instant",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "colorMode":  "value",
                                       "graphMode":  "none",
                                       "justifyMode":  "center",
                                       "orientation":  "horizontal",
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
                                                         },
                                       "showPercentChange":  false,
                                       "textMode":  "value_and_name",
                                       "wideLayout":  true
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "decimals":  0,
                                                            "displayName":  "Failed logins",
                                                            "mappings":  [

                                                                         ],
                                                            "noValue":  "0",
                                                            "unit":  "none",
                                                            "color":  {
                                                                          "mode":  "thresholds"
                                                                      },
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "#E60012",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "#FF8200",
                                                                                                 "value":  5
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       }
                   },
                   {
                       "id":  6,
                       "type":  "timeseries",
                       "title":  "p95 API Latency",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  59
                                   },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum by (le, route) (rate(hris_api_http_request_duration_seconds_bucket[5m])))",
                                           "legendFormat":  "{{route}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        }
                                       }
                   },
                   {
                       "id":  14,
                       "type":  "logs",
                       "title":  "Failed Login Details (Reason and Attempted Identifier)",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "loki"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  68
                                   },
                       "targets":  [
                                       {
                                           "expr":  "{service=~\"hris-api.*\", environment=~\"$environment\"} |= \"auth.login.failed\" | json | line_format \"{{.login_identifier_type}}={{.login_identifier}} reason={{.login_failure_reason}} status={{.status_code}} ip={{.ip}} user={{if .user_id}}{{.user_id}}{{else}}unknown{{end}} payload={{.request_payload_redacted}}\"",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showTime":  true,
                                       "showLabels":  true,
                                       "showCommonLabels":  false,
                                       "wrapLogMessage":  true,
                                       "prettifyJSON":  true,
                                       "enableLogDetails":  true
                                   }
                   }
               ]
}
