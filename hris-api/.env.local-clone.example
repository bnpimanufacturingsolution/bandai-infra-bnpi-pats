# Local Postgres clone (isolated from shared VM DEV).
# Copy to `.env.local-clone` (gitignored) after cloning:
#   docker start hris-local-dev-clone
#   # dump/restore once into 127.0.0.1:5433 — see docs/LOCAL_WINDOWS_REMOTE_DEV_BOOTSTRAP_20260720.md
#
# Use: npm run dev:local
# Normal shared DEV: npm run dev  (uses tunnel 55435; do not use this file)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hris?schema=public
WRITE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hris?schema=public
PG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hris?schema=public

# Safety flags (also forced by scripts/predev-local.cjs)
HRIS_SKIP_BNPI_DB_ACCESS=true
HRIS_SKIP_LOCAL_DB_BOOTSTRAP=true
HIKVISION_VM_BRIDGE_ENABLED=false
HRIS_SKIP_DEVICE_LIVE_PATH=true
