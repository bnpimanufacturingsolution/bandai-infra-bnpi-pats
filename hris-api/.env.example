# Server Configuration
PORT=3001
APP_HOST_PORT=58001
# Reserve localhost:3001 for the Windows npm run dev API process.
# Docker template-app should stay on 58001 unless you intentionally disable the Windows dev server.
# HOST: Set to "0.0.0.0" to allow access from LAN, or "localhost" for local-only access
# Default: "0.0.0.0" (allows LAN access)
HOST=0.0.0.0
NODE_ENV=development
PRISMA_TRANSACTION_TIMEOUT_MS=10000
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
SEED_PROVISION_CONCURRENCY=4
SEED_ARTIFACT_CONCURRENCY=3
SEED_ATTENDANCE_DAY_BATCH_SIZE=10
SEED_TX_MAX_WAIT_MS=10000
SEED_TX_TIMEOUT_MS=30000
SLOW_REQUEST_WARN_MS=10000
DEFAULT_REQUEST_TIMEOUT_MS=120000
HEAVY_REQUEST_TIMEOUT_MS=300000
HEADERS_TIMEOUT_MS=310000
KEEP_ALIVE_TIMEOUT_MS=65000

DATABASE_URL="mongodb://localhost:27018/hris?replicaSet=rs0"
PG_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hris"
POSTGRES_DB="hris"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST_PORT=5432
JWT_SECRET=TestSecretKEy12345
CLOUDINARY_CLOUD_NAME="dmhxygxg9"
CLOUDINARY_API_KEY="931468895664244"
CLOUDINARY_API_SECRET="3VlK6uVQorOQb01vwndHNSlAa-8"

# Storage backend (cloudinary|minio)
STORAGE_PROVIDER=minio

# MinIO (on-prem object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# App upload credentials consumed by helper/cloudinary.helper.ts
# Keep these aligned with MinIO users/policies in your local deployment.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=hris-images
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# Optional on-prem -> GCS backup (S3 interoperability keys)
MINIO_BACKUP_ENABLED=false
MINIO_BACKUP_INTERVAL_SECONDS=1800
GCS_BACKUP_BUCKET=
GCS_S3_ACCESS_KEY=
GCS_S3_SECRET_KEY=

# Docker/VM database backup and readable rollback evidence exports.
# hris-postgres.dump is the authoritative rollback artifact.
BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Manila
BACKUP_CRON=0 0 * * *
BACKUP_DIR=/var/backups/hris
BACKUP_RETENTION_DAYS=0
POSTGRES_CONTAINER_NAME=

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:3001,http://localhost:4173"
# Allow private LAN app origins like http://192.168.x.x:3000
ALLOW_LAN_CORS=true
# Whether to allow credentials (cookies) in CORS requests
CORS_CREDENTIALS=true

# Logging (Optional)
BETTER_STACK_ENABLED=true
BETTER_STACK_SOURCE_TOKEN="b5yYv9bssbxcJaJ7uguo8WX1"
BETTER_STACK_HOST="https://s1349486.eu-nbg-2.betterstackdata.com"

REDIS_URL=redis://:template@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=template
REDIS_DB=0
REDIS_ENABLED=true

# Auth service integration for employee migration SSO provisioning
AUTH_BASE_URL="https://adam-auth-431713067666.asia-southeast1.run.app"
IDP_ENABLED=false
AUTH_SUPERADMIN_EMAIL="super@admin.com"
AUTH_SUPERADMIN_PASSWORD="password123"
MIGRATION_DEFAULT_PASSWORD="Password123!"

# Optional: sync MongoDB cloud data into local on-prem DB during auto deploy
MONGO_SYNC_FROM_CLOUD=false
MONGO_CLOUD_DATABASE_URL=""
MONGO_LOCAL_DATABASE_URL="mongodb://root:rootpass@127.0.0.1:27018/hris?authSource=admin&replicaSet=rs0"
MONGO_SYNC_DB_NAME="hris"
