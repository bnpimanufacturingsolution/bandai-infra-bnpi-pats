# Native host Postgres (NO Docker, NO VM) — third lane, fully separate.
#
# Does NOT replace:
#   npm run dev         -> shared VM/K3s DEV via tunnel 55435
#   npm run dev:local   -> Docker clone on 127.0.0.1:5433 (.env.local-clone)
#
# This lane only:
#   npm run db:native:start     -> start embedded Postgres on 127.0.0.1:5434
#   npm run db:native:stop      -> stop that server
#   npm run dev:native          -> start DB if needed + schema push + API
#   npm run dev:native:restore  -> restore shared golden dump, then API
#   npm run db:restore:native   -> restore only (same dump as Docker lane)
#
# Shared snapshot (same file as npm run dev:local:restore):
#   ../.runtime/local-db-snapshots/current/hris-local.dump
# Capture on a machine with good data (usually via Docker):
#   npm run db:snapshot
# Copy that whole .runtime/local-db-snapshots folder here (gitignored), then:
#   npm run dev:native:restore
#
# Data dir (default): %LOCALAPPDATA%\project-truth\local-postgres
# Binaries: @embedded-postgres/windows-x64 (install once if missing)
#   npm.cmd install --no-save embedded-postgres@18.4.0-beta.17
#   node node_modules/@embedded-postgres/windows-x64/scripts/hydrate-symlinks.js
#
# Copy to `.env.local-native` (gitignored). npm run dev:native creates it if missing.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/hris?schema=public
WRITE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/hris?schema=public
PG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/hris?schema=public

# Safety flags (forced by scripts/run-dev-native.cjs)
HRIS_SKIP_BNPI_DB_ACCESS=true
HRIS_SKIP_LOCAL_DB_BOOTSTRAP=true
HIKVISION_VM_BRIDGE_ENABLED=false
HRIS_SKIP_DEVICE_LIVE_PATH=true
HRIS_SKIP_HIKVISION_REMOTE_DEVICE_TUNNEL=true
PROJECT_TRUTH_DISABLE_K8S_DB_WATCH=true
